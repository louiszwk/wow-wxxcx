.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 14px 16px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 10px;
  font-size: 15px;
  cursor: pointer;
}

.back-icon {
  font-size: 22px;
  margin-right: 4px;
}

.header {
  margin-bottom: 10px;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 22px;
  font-weight: 800;
  background: linear-gradient(135deg, #06b6d4 0%, #a855f7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #0891b2 0%, #7e22ce 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 11px;
  color: #94a3b8;
  margin-top: 2px;
}

.theme-light .subtitle {
  color: #64748b;
}

.theme-toggle {
  font-size: 20px;
  padding: 4px;
}

/* Layout */
.game-layout {
  display: flex;
  gap: 12px;
  justify-content: center;
  align-items: flex-start;
  margin-bottom: 12px;
}

/* Board Frame */
.board-frame {
  position: relative;
  background: rgba(15, 23, 42, 0.9);
  border: 2px solid rgba(6, 182, 212, 0.4);
  border-radius: 12px;
  padding: 4px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.theme-light .board-frame {
  background: #dbeafe;
  border-color: #93c5fd;
  box-shadow: 0 8px 20px rgba(180, 205, 230, 0.4);
}

.tetris-row {
  display: flex;
}

.tetris-cell {
  width: 19px;
  height: 19px;
  margin: 1px;
  background: rgba(30, 41, 59, 0.6);
  border-radius: 3px;
  box-sizing: border-box;
}

.theme-light .tetris-cell {
  background: #f3f7fc;
}

.tetris-cell.filled {
  border: 1px solid rgba(255, 255, 255, 0.4);
  box-shadow: inset 1px 1px 2px rgba(255, 255, 255, 0.3);
}

.board-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  backdrop-filter: blur(2px);
}

.theme-light .board-overlay {
  background: rgba(224, 242, 254, 0.8);
}

.overlay-icon {
  font-size: 36px;
  margin-bottom: 6px;
}

.overlay-text {
  font-size: 14px;
  font-weight: 700;
  color: #38bdf8;
}

/* Side Panel */
.side-panel {
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 90px;
}

.side-card {
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  padding: 6px 8px;
  text-align: center;
}

.theme-light .side-card {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.card-title {
  font-size: 11px;
  color: #94a3b8;
  display: block;
  margin-bottom: 2px;
}

.theme-light .card-title {
  color: #64748b;
}

.card-val {
  font-size: 14px;
  font-weight: 800;
  font-family: monospace;
}

.highlight {
  color: #06b6d4;
}

/* Next Piece Preview */
.preview-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 38px;
  justify-content: center;
}

.p-row {
  display: flex;
}

.p-cell {
  width: 10px;
  height: 10px;
  margin: 1px;
}

.p-filled {
  background: #06b6d4;
  border-radius: 2px;
}

/* Virtual Controls */
.virtual-controls {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 0 10px 6px;
}

.ctrl-row {
  display: flex;
  justify-content: center;
  gap: 12px;
}

.ctrl-btn {
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  user-select: none;
  transition: all 0.1s ease;
}

.theme-light .ctrl-btn {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
  color: #0f2742;
}

.rotate-btn, .drop-btn {
  flex: 1;
  padding: 10px 0;
  font-size: 14px;
  font-weight: 700;
}

.rotate-btn {
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.3) 0%, rgba(59, 130, 246, 0.3) 100%);
  border-color: #06b6d4;
}

.drop-btn {
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.3) 0%, rgba(245, 158, 11, 0.3) 100%);
  border-color: #f59e0b;
}

.arrow-btn {
  flex: 1;
  height: 48px;
  font-size: 20px;
}

.ctrl-btn:active {
  transform: scale(0.94);
  background: rgba(255, 255, 255, 0.2);
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-card {
  width: 80%;
  background: #1e293b;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 24px 20px;
  text-align: center;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
}

.theme-light .modal-card {
  background: #f3f7fc;
  border: 1px solid #bfdbfe;
  color: #0f2742;
}

.modal-icon {
  font-size: 46px;
  margin-bottom: 8px;
}

.modal-title {
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 8px;
}

.modal-desc {
  font-size: 14px;
  color: #94a3b8;
  margin-bottom: 20px;
}

.theme-light .modal-desc {
  color: #475569;
}

.modal-score {
  font-size: 18px;
  font-weight: 800;
  color: #06b6d4;
}

.modal-btn-row {
  display: flex;
  gap: 10px;
}

.modal-btn {
  flex: 1;
  font-size: 14px;
  font-weight: 700;
  border-radius: 20px;
  border: none;
  padding: 8px 0;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #06b6d4 0%, #a855f7 100%);
  color: #ffffff;
}

.modal-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.theme-light .modal-btn.secondary {
  background: #e2e8f0;
  border-color: #cbd5e1;
}
