.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 20px;
  font-size: 16px;
  cursor: pointer;
}

.back-icon {
  font-size: 24px;
  margin-right: 5px;
  margin-top: -2px;
}

.header {
  position: relative;
  margin-bottom: 20px;
}

.title {
  font-size: 26px;
  font-weight: 800;
  background: linear-gradient(135deg, #fbbf24 0%, #ec4899 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #d97706 0%, #be185d 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 13px;
  color: #94a3b8;
  margin-top: 4px;
}

.theme-light .subtitle {
  color: #475569;
}

.theme-toggle {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 22px;
  padding: 8px;
}

/* Fountain Hero */
.fountain-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(30, 58, 138, 0.4) 0%, rgba(88, 28, 135, 0.4) 100%);
  border: 1px solid rgba(251, 191, 36, 0.3);
  border-radius: 20px;
  padding: 24px 20px;
  text-align: center;
  margin-bottom: 20px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.theme-light .fountain-hero {
  background: linear-gradient(135deg, #e0f2fe 0%, #ede9fe 100%);
  border: 1px solid #bfdbfe;
  box-shadow: 0 8px 24px rgba(180, 205, 230, 0.4);
}

.fountain-icon {
  font-size: 44px;
  margin-bottom: 8px;
  filter: drop-shadow(0 0 12px rgba(251, 191, 36, 0.6));
}

.fountain-title {
  font-size: 20px;
  font-weight: 800;
  color: #fbbf24;
  margin-bottom: 6px;
}

.theme-light .fountain-title {
  color: #b45309;
}

.fountain-desc {
  font-size: 13px;
  color: #cbd5e1;
  margin-bottom: 18px;
}

.theme-light .fountain-desc {
  color: #475569;
}

.fountain-action-row {
  display: flex;
  justify-content: center;
}

.make-wish-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  color: #0f172a;
  font-weight: 700;
  font-size: 15px;
  padding: 12px 28px;
  border-radius: 30px;
  box-shadow: 0 4px 16px rgba(245, 158, 11, 0.4);
  transition: transform 0.2s ease;
}

.make-wish-btn:active {
  transform: scale(0.97);
}

.btn-coin {
  font-size: 18px;
}

/* Category Chips */
.category-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 14px;
  padding: 2px 0 4px;
  box-sizing: border-box;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 28px;
  line-height: 28px;
  padding: 0 12px;
  font-size: 12px;
  font-weight: 500;
  border-radius: 14px;
  background: rgba(30, 41, 59, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #94a3b8;
  margin-right: 8px;
  transition: all 0.2s ease;
  box-sizing: border-box;
  vertical-align: middle;
  flex-shrink: 0;
}

.theme-light .cat-chip {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
  color: #475569;
}

.cat-chip.active {
  background: #f59e0b;
  color: #0f172a;
  border-color: #fbbf24;
  font-weight: 700;
}

.theme-light .cat-chip.active {
  background: #d97706;
  color: #ffffff;
}

/* Wishes Grid */
.wishes-grid {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.wish-card {
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

.theme-light .wish-card {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
  box-shadow: 0 4px 16px rgba(180, 205, 230, 0.3);
}

.wish-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.author-box {
  display: flex;
  align-items: center;
  gap: 8px;
}

.class-avatar {
  font-size: 22px;
}

.author-meta {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 14px;
  font-weight: 700;
}

.wish-date {
  font-size: 11px;
  color: #94a3b8;
}

.theme-light .wish-date {
  color: #64748b;
}

.wish-cat-tag {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 6px;
  background: rgba(251, 191, 36, 0.15);
  color: #fbbf24;
  font-weight: 600;
}

.theme-light .wish-cat-tag {
  background: #fef3c7;
  color: #d97706;
}

.wish-body {
  font-size: 14px;
  line-height: 1.6;
  color: #e2e8f0;
  font-style: italic;
  margin-bottom: 12px;
}

.theme-light .wish-body {
  color: #1e293b;
}

.wish-footer {
  display: flex;
  justify-content: flex-end;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  padding-top: 10px;
}

.theme-light .wish-footer {
  border-top: 1px solid #e2e8f0;
}

.like-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 12px;
  color: #cbd5e1;
}

.theme-light .like-btn {
  background: #e2e8f0;
  border: 1px solid #cbd5e1;
  color: #334155;
}

.like-btn.liked {
  border-color: rgba(239, 68, 68, 0.4);
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.modal-box {
  width: 100%;
  max-width: 400px;
  background: #1e293b;
  border: 1px solid rgba(251, 191, 36, 0.3);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.theme-light .modal-box {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
  color: #0f2742;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.modal-title {
  font-size: 17px;
  font-weight: 700;
  color: #fbbf24;
}

.theme-light .modal-title {
  color: #d97706;
}

.modal-close {
  font-size: 18px;
  color: #94a3b8;
  padding: 4px;
}

.form-group {
  margin-bottom: 14px;
}

.form-row {
  display: flex;
  gap: 12px;
  margin-bottom: 14px;
}

.form-col {
  flex: 1;
}

.form-label {
  display: block;
  font-size: 12px;
  color: #94a3b8;
  margin-bottom: 6px;
}

.theme-light .form-label {
  color: #64748b;
}

.form-input {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  padding: 8px 12px;
  font-size: 14px;
  color: inherit;
}

.theme-light .form-input {
  background: #e8f1f8;
  border: 1px solid #cde0f0;
}

.form-picker-val {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  padding: 8px 12px;
  font-size: 13px;
  color: inherit;
}

.theme-light .form-picker-val {
  background: #e8f1f8;
  border: 1px solid #cde0f0;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 14px;
  height: 90px;
  color: inherit;
}

.theme-light .form-textarea {
  background: #e8f1f8;
  border: 1px solid #cde0f0;
}

.submit-btn {
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  color: #0f172a;
  font-weight: 700;
  font-size: 15px;
  border-radius: 12px;
  border: none;
  padding: 12px 0;
  width: 100%;
  margin-top: 10px;
}
