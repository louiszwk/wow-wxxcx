<view class="page-container theme-{{theme}}">
  <scroll-view class="scrollarea" scroll-y="true">
    
    <!-- 顶部导航 -->
    <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
      <text class="back-icon">‹</text>
      <text class="back-text">游乐场</text>
    </view>

    <!-- 标题与主题切换 -->
    <view class="header">
      <view class="title-wrap">
        <text class="title">⚡ 秒断特训营</text>
      </view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>

    <!-- 1. 准备界面 (Ready) -->
    <view class="ready-view" wx:if="{{gameState === 'ready'}}">
      <view class="intro-card">
        <view class="intro-icon">⚡</view>
        <view class="intro-title">魔兽读条打断反应测试</view>
        <view class="intro-desc">
          模拟大秘境高压小怪读条战斗！测试你的极限手速与克制力：
        </view>
        
        <view class="rule-list">
          <view class="rule-item">
            <view class="rule-dot green"></view>
            <view class="rule-content">
              <text class="rule-title">普通读条（金边）</text>
              <text class="rule-text">必须立即打断！秒断或极限压哨（>80%）可获巨额额外加分。</text>
            </view>
          </view>

          <view class="rule-item">
            <view class="rule-dot orange"></view>
            <view class="rule-content">
              <text class="rule-title">钢条护盾（银盾 🛡️）</text>
              <text class="rule-text">免疫打断！切勿按键，忍住不按方可加分，误按将严重扣分！</text>
            </view>
          </view>

          <view class="rule-item">
            <view class="rule-dot red"></view>
            <view class="rule-content">
              <text class="rule-title">生存与连击</text>
              <text class="rule-text">共 10 轮测试，拥有 3 点生命值。连击越高得分倍率越高！</text>
            </view>
          </view>
        </view>

        <button class="primary-btn start-btn" bindtap="startGame">
          <text class="btn-text">开始特训</text>
        </button>
      </view>
    </view>

    <!-- 2. 游戏对决界面 (Playing) -->
    <view class="playing-view" wx:if="{{gameState === 'playing'}}">
      
      <!-- 状态栏: 回合、生命值、积分、连击 -->
      <view class="status-bar">
        <view class="round-badge">第 {{round}} / {{maxRounds}} 轮</view>
        <view class="lives-box">
          <text class="heart {{lives >= 1 ? 'alive' : 'dead'}}">❤️</text>
          <text class="heart {{lives >= 2 ? 'alive' : 'dead'}}">❤️</text>
          <text class="heart {{lives >= 3 ? 'alive' : 'dead'}}">❤️</text>
        </view>
        <view class="score-display">
          <text class="score-val">{{score}}</text>
          <text class="score-lbl">分</text>
        </view>
      </view>

      <!-- 连击提示 -->
      <view class="combo-banner" wx:if="{{combo > 1}}">
        <text class="combo-icon">🔥</text>
        <text class="combo-text">COMBO x{{combo}} (+{{(combo - 1) * 15}}分)</text>
      </view>

      <!-- 目标怪物施法面板 -->
      <view class="cast-arena">
        
        <!-- 怪物信息条 -->
        <view class="caster-header">
          <view class="caster-avatar">{{currentSpell.icon || '👾'}}</view>
          <view class="caster-meta">
            <view class="caster-name">{{currentSpell.caster}}</view>
            <view class="caster-threat {{currentSpell.isShielded ? 'threat-shield' : 'threat-danger'}}">
              {{currentSpell.isShielded ? '🛡️ 钢条护盾 (严禁打断)' : '⚠️ 致命法术 (必须打断)'}}
            </view>
          </view>
        </view>

        <!-- 施法读条核心组件 -->
        <view class="castbar-box {{currentSpell.isShielded ? 'castbar-shielded' : 'castbar-normal'}}">
          <view class="castbar-header">
            <view class="spell-info">
              <text class="shield-badge" wx:if="{{currentSpell.isShielded}}">🛡️ 钢条</text>
              <text class="spell-name">{{currentSpell.spell}}</text>
            </view>
            <view class="cast-pct">{{progressPercent}}%</view>
          </view>
          
          <!-- 动态进度条 -->
          <view class="castbar-track">
            <view class="castbar-fill {{currentSpell.isShielded ? 'fill-shielded' : 'fill-normal'}}" style="width: {{progressPercent}}%;"></view>
          </view>
        </view>

        <view class="spell-desc-box">
          <text class="desc-text">{{currentSpell.desc}}</text>
        </view>

        <!-- 回合判定即时反馈 -->
        <view class="round-feedback feedback-{{roundFeedback.type}}" wx:if="{{roundFeedback}}">
          <view class="fb-title">{{roundFeedback.title}}</view>
          <view class="fb-badge">{{roundFeedback.badge}}</view>
          <view class="fb-text">{{roundFeedback.text}}</view>
        </view>

      </view>

      <!-- 核心打断操作大按键 -->
      <view class="action-dock">
        <button class="kick-action-btn {{isCasting ? 'active-kick' : 'disabled-kick'}}" bindtap="onInterruptTap">
          <view class="kick-btn-glow" wx:if="{{isCasting}}"></view>
          <text class="kick-btn-icon">⚡</text>
          <view class="kick-btn-labels">
            <text class="kick-btn-main">打断 / 脚踢</text>
            <text class="kick-btn-sub">INTERRUPT</text>
          </view>
        </button>
      </view>

    </view>

    <!-- 3. 结算界面 (Game Over) -->
    <view class="gameover-view" wx:if="{{gameState === 'game_over'}}">
      <view class="result-card">
        
        <view class="result-badge-top" wx:if="{{resultSummary.isNewBest}}">🎉 刷新个人最佳纪录！</view>

        <view class="rank-crown">{{resultSummary.rankBadge}}</view>
        <view class="rank-tier">{{resultSummary.rankTier}}</view>
        <view class="rank-title">「{{resultSummary.rankTitle}}」</view>
        
        <view class="score-spotlight">
          <text class="spotlight-num">{{resultSummary.score}}</text>
          <text class="spotlight-unit">最终得分</text>
        </view>

        <view class="stats-grid">
          <view class="stat-card">
            <text class="sc-val">{{resultSummary.avgMs}} ms</text>
            <text class="sc-lbl">平均反应</text>
          </view>
          <view class="stat-card">
            <text class="sc-val">{{resultSummary.maxCombo}} 次</text>
            <text class="sc-lbl">最高连击</text>
          </view>
          <view class="stat-card">
            <text class="sc-val">{{resultSummary.misses}} 次</text>
            <text class="sc-lbl">失误次数</text>
          </view>
        </view>

        <view class="result-actions">
          <button class="primary-btn retry-btn" bindtap="startGame">
            <text class="btn-text">再战一把 ↻</text>
          </button>
          <button class="secondary-btn share-btn" open-type="share">
            <text class="btn-text">炫耀手速 🚀</text>
          </button>
        </view>

        <view class="back-link" bindtap="navigateBack">
          <text>返回游乐场大厅</text>
        </view>

      </view>
    </view>

  </scroll-view>
</view>
