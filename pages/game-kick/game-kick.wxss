/* ================= 主题变量 ================= */
.theme-light {
  --bg-color: #f3f4f6;
  --card-bg: #ffffff;
  --card-border: #e5e7eb;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --cast-bg: #1e293b;
}

.theme-dark {
  --bg-color: #0b0f19;
  --card-bg: #151d30;
  --card-border: #222f4c;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --cast-bg: #090d16;
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.scrollarea {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx 60rpx;
}

/* 顶部导航 */
.nav-header {
  display: flex;
  align-items: center;
  color: var(--text-primary);
  font-size: 32rpx;
  cursor: pointer;
}

.back-icon {
  font-size: 48rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.back-text {
  font-size: 30rpx;
  font-weight: 500;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0 28rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.theme-toggle {
  font-size: 34rpx;
  padding: 12rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 30rpx;
}

/* ================= 1. 准备界面 ================= */
.ready-view {
  margin-top: 20rpx;
}

.intro-card {
  background-color: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.2);
  text-align: center;
}

.intro-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.intro-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 36rpx;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  text-align: left;
  margin-bottom: 44rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 18rpx;
  padding: 20rpx;
}

.rule-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.rule-dot.green { background-color: #22c55e; box-shadow: 0 0 10rpx #22c55e; }
.rule-dot.orange { background-color: #f97316; box-shadow: 0 0 10rpx #f97316; }
.rule-dot.red { background-color: #ef4444; box-shadow: 0 0 10rpx #ef4444; }

.rule-content {
  flex: 1;
}

.rule-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.rule-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.45;
}

.primary-btn {
  background: linear-gradient(135deg, #eab308, #f59e0b);
  color: #1e1b4b;
  font-weight: 800;
  font-size: 32rpx;
  border-radius: 44rpx;
  padding: 24rpx 0;
  width: 100%;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(234, 179, 8, 0.35);
}

.primary-btn:active {
  transform: scale(0.98);
}

/* ================= 2. 游戏对战界面 ================= */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 18rpx 26rpx;
  margin-bottom: 24rpx;
}

.round-badge {
  font-size: 26rpx;
  font-weight: 700;
  color: #38bdf8;
}

.lives-box {
  display: flex;
  gap: 8rpx;
}

.heart {
  font-size: 32rpx;
  transition: opacity 0.3s;
}

.heart.dead {
  opacity: 0.2;
  filter: grayscale(1);
}

.score-display {
  display: flex;
  align-items: baseline;
}

.score-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #f59e0b;
}

.score-lbl {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

.combo-banner {
  background: linear-gradient(90deg, rgba(239, 68, 68, 0.2), rgba(249, 115, 22, 0.25));
  border: 1rpx solid rgba(239, 68, 68, 0.4);
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  animation: pulse 1s infinite alternate;
}

@keyframes pulse {
  0% { transform: scale(0.98); }
  100% { transform: scale(1.02); }
}

.combo-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.combo-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #f87171;
}

/* 施法竞技场 */
.cast-arena {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.25);
  position: relative;
}

.caster-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.caster-avatar {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.caster-meta {
  flex: 1;
}

.caster-name {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.caster-threat {
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

.threat-danger {
  color: #f87171;
}

.threat-shield {
  color: #94a3b8;
}

/* 核心读条组件 (仿魔兽插件 Plater / ElvUI) */
.castbar-box {
  background: var(--cast-bg);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.castbar-normal {
  border: 2rpx solid #eab308;
  box-shadow: 0 0 20rpx rgba(234, 179, 8, 0.25);
}

.castbar-shielded {
  border: 2rpx solid #94a3b8;
  box-shadow: 0 0 20rpx rgba(148, 163, 184, 0.2);
}

.castbar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.spell-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.shield-badge {
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 10rpx;
  background: rgba(148, 163, 184, 0.25);
  color: #cbd5e1;
  border-radius: 6rpx;
}

.spell-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
}

.cast-pct {
  font-size: 28rpx;
  font-weight: 800;
  color: #f59e0b;
}

.castbar-track {
  width: 100%;
  height: 28rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 14rpx;
  overflow: hidden;
}

.castbar-fill {
  height: 100%;
  transition: width 0.03s linear;
}

.fill-normal {
  background: linear-gradient(90deg, #f59e0b, #ef4444);
  box-shadow: 0 0 12rpx #f59e0b;
}

.fill-shielded {
  background: linear-gradient(90deg, #64748b, #94a3b8);
  box-shadow: 0 0 12rpx #94a3b8;
}

.spell-desc-box {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

/* 回合反馈浮窗 */
.round-feedback {
  margin-top: 24rpx;
  border-radius: 18rpx;
  padding: 20rpx;
  text-align: center;
  animation: popIn 0.2s ease-out;
}

@keyframes popIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

.feedback-success {
  background: rgba(34, 197, 94, 0.15);
  border: 1rpx solid rgba(34, 197, 94, 0.4);
  color: #22c55e;
}

.feedback-shield_error {
  background: rgba(239, 68, 68, 0.15);
  border: 1rpx solid rgba(239, 68, 68, 0.4);
  color: #f87171;
}

.feedback-miss {
  background: rgba(239, 68, 68, 0.2);
  border: 1rpx solid rgba(239, 68, 68, 0.5);
  color: #f87171;
}

.feedback-shield_success {
  background: rgba(59, 130, 246, 0.15);
  border: 1rpx solid rgba(59, 130, 246, 0.4);
  color: #60a5fa;
}

.fb-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.fb-badge {
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.fb-text {
  font-size: 22rpx;
  opacity: 0.9;
}

/* 核心按键 Dock */
.action-dock {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.kick-action-btn {
  width: 90%;
  height: 150rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border: none;
  transition: all 0.15s ease;
}

.active-kick {
  background: linear-gradient(135deg, #eab308, #ea580c);
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(234, 179, 8, 0.5);
}

.active-kick:active {
  transform: scale(0.93);
  box-shadow: 0 8rpx 20rpx rgba(234, 179, 8, 0.3);
}

.disabled-kick {
  background: #374151;
  color: #9ca3af;
  opacity: 0.6;
}

.kick-btn-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.kick-btn-labels {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.kick-btn-main {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.kick-btn-sub {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  opacity: 0.8;
}

/* ================= 3. 结算界面 ================= */
.gameover-view {
  margin-top: 20rpx;
}

.result-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.3);
  position: relative;
}

.result-badge-top {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 800;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.rank-crown {
  font-size: 96rpx;
  margin-bottom: 12rpx;
}

.rank-tier {
  font-size: 64rpx;
  font-weight: 900;
  color: #38bdf8;
  line-height: 1;
}

.rank-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin: 12rpx 0 32rpx;
}

.score-spotlight {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.spotlight-num {
  display: block;
  font-size: 68rpx;
  font-weight: 900;
  color: #eab308;
}

.spotlight-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
}

.sc-val {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.sc-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--card-border);
  color: var(--text-primary);
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 22rpx 0;
  width: 100%;
}

.back-link {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 10rpx;
}
