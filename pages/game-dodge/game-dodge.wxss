/* ================= 主题变量 ================= */
.theme-light {
  --bg-color: #f3f4f6;
  --card-bg: #ffffff;
  --card-border: #e5e7eb;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --tile-bg: #e5e7eb;
}

.theme-dark {
  --bg-color: #0b0f19;
  --card-bg: #151d30;
  --card-border: #222f4c;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --tile-bg: #1e293b;
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.scrollarea {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx 60rpx;
}

.nav-header {
  display: flex;
  align-items: center;
  color: var(--text-primary);
  font-size: 32rpx;
  cursor: pointer;
}

.back-icon {
  font-size: 48rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.back-text {
  font-size: 30rpx;
  font-weight: 500;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0 28rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.theme-toggle {
  font-size: 34rpx;
  padding: 12rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 30rpx;
}

/* ================= 1. 准备界面 ================= */
.ready-view {
  margin-top: 20rpx;
}

.intro-card {
  background-color: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.2);
  text-align: center;
}

.intro-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.intro-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 36rpx;
}

.hazard-guide {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  text-align: left;
  margin-bottom: 44rpx;
}

.hg-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 20rpx;
}

.hg-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.hg-meta {
  flex: 1;
}

.hg-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.hg-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.primary-btn {
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: #ffffff;
  font-weight: 800;
  font-size: 32rpx;
  border-radius: 44rpx;
  padding: 24rpx 0;
  width: 100%;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(249, 115, 22, 0.35);
}

.primary-btn:active {
  transform: scale(0.98);
}

/* ================= 2. 游戏对战界面 ================= */
.dodge-hud {
  display: flex;
  justify-content: space-between;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 18rpx 28rpx;
  margin-bottom: 24rpx;
}

.hud-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.hud-val {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.wave-val {
  color: #f97316;
}

.score-val {
  color: #f59e0b;
}

.lives-row {
  display: flex;
  gap: 6rpx;
  margin-top: 4rpx;
}

.heart {
  font-size: 28rpx;
}

.heart.dead {
  opacity: 0.2;
  filter: grayscale(1);
}

/* 预警栏 */
.hazard-banner {
  background: rgba(249, 115, 22, 0.12);
  border: 1rpx solid rgba(249, 115, 22, 0.35);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.hb-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #fb923c;
  margin-bottom: 4rpx;
}

.hb-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
}

.warn-bar-track {
  width: 100%;
  height: 12rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.warn-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #f97316, #ef4444);
  transition: width 0.03s linear;
}

/* 3x3 战场网格 */
.arena-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.grid-tile {
  aspect-ratio: 1 / 1;
  background: var(--tile-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
}

.grid-tile:active {
  transform: scale(0.96);
}

/* 玩家在格子里 */
.tile-player {
  border-color: #38bdf8 !important;
  background: rgba(56, 189, 248, 0.15) !important;
  box-shadow: 0 0 20rpx rgba(56, 189, 248, 0.35);
}

.player-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.player-icon {
  font-size: 64rpx;
  z-index: 2;
}

.player-ring {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx dashed #38bdf8;
  animation: rotateRing 4s linear infinite;
}

@keyframes rotateRing {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 危险预警格子 */
.tile-hazard {
  border-color: #ef4444 !important;
  background: rgba(239, 68, 68, 0.25) !important;
  animation: hazardPulse 0.4s infinite alternate;
}

@keyframes hazardPulse {
  0% { transform: scale(0.98); box-shadow: inset 0 0 10rpx #ef4444; }
  100% { transform: scale(1.02); box-shadow: inset 0 0 30rpx #ef4444; }
}

.hazard-indicator {
  position: absolute;
  font-size: 56rpx;
  opacity: 0.85;
}

/* 引爆瞬间 */
.tile-detonated {
  background: #ef4444 !important;
  box-shadow: 0 0 40rpx #ef4444 !important;
}

.safe-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--card-border);
  opacity: 0.5;
}

.arena-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ================= 3. 结算界面 ================= */
.gameover-view {
  margin-top: 20rpx;
}

.result-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.3);
}

.result-badge-top {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 800;
  color: #f97316;
  background: rgba(249, 115, 22, 0.15);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.rank-crown {
  font-size: 96rpx;
  margin-bottom: 12rpx;
}

.rank-tier {
  font-size: 64rpx;
  font-weight: 900;
  color: #f97316;
  line-height: 1;
}

.rank-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin: 12rpx 0 32rpx;
}

.score-spotlight {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.spotlight-num {
  display: block;
  font-size: 68rpx;
  font-weight: 900;
  color: #f59e0b;
}

.spotlight-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
}

.sc-val {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.sc-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--card-border);
  color: var(--text-primary);
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 22rpx 0;
  width: 100%;
}

.back-link {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 10rpx;
}
