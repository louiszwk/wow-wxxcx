<view class="page-container theme-{{theme}}">
  <scroll-view class="scrollarea" scroll-y="true">
    
    <!-- 顶部导航 -->
    <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
      <text class="back-icon">‹</text>
      <text class="back-text">游乐场</text>
    </view>

    <!-- 标题与主题切换 -->
    <view class="header">
      <view class="title-wrap">
        <text class="title">🏃 词缀走位大挑战</text>
      </view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>

    <!-- 1. 准备界面 (Ready) -->
    <view class="ready-view" wx:if="{{gameState === 'ready'}}">
      <view class="intro-card">
        <view class="intro-icon">🌋</view>
        <view class="intro-title">九宫格身法避雷极限生存</view>
        <view class="intro-desc">
          模拟大秘境高压词缀！脚底踩火？满地血池？拒绝当人形炸弹，测测你能坚持存活几波！
        </view>

        <view class="hazard-guide">
          <view class="hg-item">
            <text class="hg-icon">🌋</text>
            <view class="hg-meta">
              <text class="hg-name">火山喷发</text>
              <text class="hg-desc">脚底裂缝闪烁预警，迅速侧移躲避</text>
            </view>
          </view>

          <view class="hg-item">
            <text class="hg-icon">🩸</text>
            <view class="hg-meta">
              <text class="hg-name">腐蚀血池</text>
              <text class="hg-desc">小怪遗留血水，误入将扣除生命值</text>
            </view>
          </view>

          <view class="hg-item">
            <text class="hg-icon">🌪️</text>
            <view class="hg-meta">
              <text class="hg-name">狂暴风雷</text>
              <text class="hg-desc">龙卷风旋转席卷，观察安全空格走位</text>
            </view>
          </view>
        </view>

        <button class="primary-btn start-btn" bindtap="startGame">
          <text class="btn-text">开始特训</text>
        </button>
      </view>
    </view>

    <!-- 2. 游戏对战界面 (Playing) -->
    <view class="playing-view" wx:if="{{gameState === 'playing'}}">
      
      <!-- 游戏顶栏 HUD -->
      <view class="dodge-hud">
        <view class="hud-item">
          <text class="hud-lbl">生存波数</text>
          <text class="hud-val wave-val">WAVE {{wave}}</text>
        </view>

        <view class="hud-item">
          <text class="hud-lbl">生命值</text>
          <view class="lives-row">
            <text class="heart {{lives >= 1 ? 'alive' : 'dead'}}">❤️</text>
            <text class="heart {{lives >= 2 ? 'alive' : 'dead'}}">❤️</text>
            <text class="heart {{lives >= 3 ? 'alive' : 'dead'}}">❤️</text>
          </view>
        </view>

        <view class="hud-item">
          <text class="hud-lbl">得分</text>
          <text class="hud-val score-val">{{score}}</text>
        </view>
      </view>

      <!-- 词缀预警条 -->
      <view class="hazard-banner" wx:if="{{currentHazardInfo}}">
        <view class="hb-title">{{currentHazardInfo.name}} 预警中！</view>
        <view class="hb-desc">{{currentHazardInfo.desc}}</view>
        <!-- 预警倒计时条 -->
        <view class="warn-bar-track">
          <view class="warn-bar-fill" style="width: {{warnProgress}}%;"></view>
        </view>
      </view>

      <!-- 3x3 战场九宫格 -->
      <view class="arena-grid">
        <view 
          class="grid-tile {{item.isPlayer ? 'tile-player' : ''}} {{item.isHazard ? 'tile-hazard hazard-' + item.hazardType : ''}} {{item.isDetonated ? 'tile-detonated' : ''}}"
          wx:for="{{gridTiles}}"
          wx:key="id"
          data-index="{{item.id}}"
          bindtap="onTileTap">
          
          <!-- 危险警示物 -->
          <view class="hazard-indicator" wx:if="{{item.isHazard}}">
            <text class="hazard-icon" wx:if="{{item.hazardType === 'volcano'}}">🌋</text>
            <text class="hazard-icon" wx:elif="{{item.hazardType === 'sanguine'}}">🩸</text>
            <text class="hazard-icon" wx:elif="{{item.hazardType === 'storming'}}">🌪️</text>
            <text class="hazard-icon" wx:else>⚡</text>
          </view>

          <!-- 玩家角色标识 -->
          <view class="player-avatar" wx:if="{{item.isPlayer}}">
            <text class="player-icon">🛡️</text>
            <view class="player-ring"></view>
          </view>

          <!-- 安全区提示 (非危险非玩家) -->
          <view class="safe-dot" wx:if="{{!item.isHazard && !item.isPlayer}}"></view>

        </view>
      </view>

      <view class="arena-tip">
        <text>💡 点击任意安全格子瞬移走位，躲避危险圈！</text>
      </view>

    </view>

    <!-- 3. 结算界面 (Game Over) -->
    <view class="gameover-view" wx:if="{{gameState === 'game_over'}}">
      <view class="result-card">
        <view class="result-badge-top" wx:if="{{resultSummary.isNewBest}}">🎉 刷新个人最高生存波数！</view>

        <view class="rank-crown">{{resultSummary.badge}}</view>
        <view class="rank-tier">{{resultSummary.tier}}</view>
        <view class="rank-title">「{{resultSummary.title}}」</view>

        <view class="score-spotlight">
          <text class="spotlight-num">{{resultSummary.waves}}</text>
          <text class="spotlight-unit">成功坚持波数</text>
        </view>

        <view class="stats-grid">
          <view class="stat-card">
            <text class="sc-val">{{resultSummary.score}} 分</text>
            <text class="sc-lbl">走位总积分</text>
          </view>
          <view class="stat-card">
            <text class="sc-val">{{resultSummary.waves >= 15 ? '高玩身法' : (resultSummary.waves >= 8 ? '及格水平' : '仍需苦练')}}</text>
            <text class="sc-lbl">评价等级</text>
          </view>
        </view>

        <view class="result-actions">
          <button class="primary-btn retry-btn" bindtap="startGame">
            <text class="btn-text">再挑战一次 ↻</text>
          </button>
          <button class="secondary-btn share-btn" open-type="share">
            <text class="btn-text">晒晒走位波数 🚀</text>
          </button>
        </view>

        <view class="back-link" bindtap="navigateBack">
          <text>返回游乐场大厅</text>
        </view>

      </view>
    </view>

  </scroll-view>
</view>
