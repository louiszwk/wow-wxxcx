/* ================= 主题变量 ================= */
.theme-light {
  --bg-color: #f3f4f6;
  --card-bg: #ffffff;
  --card-border: #e5e7eb;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --hole-bg: #475569;
  --hole-shadow: inset 0 10rpx 20rpx rgba(0, 0, 0, 0.4);
}

.theme-dark {
  --bg-color: #0b0f19;
  --card-bg: #151d30;
  --card-border: #222f4c;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --hole-bg: #090d16;
  --hole-shadow: inset 0 12rpx 24rpx rgba(0, 0, 0, 0.7);
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.scrollarea {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx 60rpx;
}

.nav-header {
  display: flex;
  align-items: center;
  color: var(--text-primary);
  font-size: 32rpx;
  cursor: pointer;
}

.back-icon {
  font-size: 48rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.back-text {
  font-size: 30rpx;
  font-weight: 500;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.theme-toggle {
  font-size: 34rpx;
  padding: 12rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 30rpx;
}

/* 1. 准备界面 */
.ready-view {
  margin-top: 20rpx;
}

.intro-card {
  background-color: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.2);
  text-align: center;
}

.intro-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.intro-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 36rpx;
}

.target-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  text-align: left;
  margin-bottom: 40rpx;
}

.target-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}

.tg-icon {
  font-size: 44rpx;
  margin-right: 18rpx;
}

.tg-meta {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tg-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.tg-score {
  font-size: 26rpx;
  font-weight: 800;
  color: #22c55e;
}

.primary-btn {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #1e1b4b;
  font-weight: 800;
  font-size: 32rpx;
  border-radius: 44rpx;
  padding: 24rpx 0;
  width: 100%;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(245, 158, 11, 0.35);
}

.primary-btn:active {
  transform: scale(0.98);
}

/* 2. 对战界面 */
.mole-hud {
  display: flex;
  justify-content: space-between;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 18rpx 28rpx;
  margin-bottom: 24rpx;
}

.hud-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.hud-val {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.time-val {
  color: #38bdf8;
}

.time-urgent {
  color: #ef4444;
  animation: urgentBlink 0.6s infinite alternate;
}

@keyframes urgentBlink {
  0% { transform: scale(1); }
  100% { transform: scale(1.15); }
}

.score-val {
  color: #f59e0b;
}

.combo-pill {
  background: linear-gradient(90deg, rgba(245, 158, 11, 0.2), rgba(239, 68, 68, 0.2));
  border: 1rpx solid rgba(245, 158, 11, 0.3);
  border-radius: 14rpx;
  padding: 10rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #fbbf24;
  margin-bottom: 24rpx;
}

/* 3x3 矿坑网格 */
.mine-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.mine-hole {
  aspect-ratio: 1 / 1;
  background: var(--hole-bg);
  border: 4rpx solid #334155;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-shadow: var(--hole-shadow);
  transition: all 0.1s ease;
}

.mine-hole:active {
  transform: scale(0.94);
}

.hole-rim {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 35%;
  background: linear-gradient(to top, #1e293b, transparent);
  pointer-events: none;
  z-index: 3;
}

.mole-entity {
  position: relative;
  z-index: 2;
  animation: molePop 0.18s ease-out;
}

@keyframes molePop {
  0% { transform: translateY(60rpx) scale(0.6); }
  100% { transform: translateY(0) scale(1); }
}

.entity-icon {
  font-size: 76rpx;
}

.hit-splat {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  animation: splatAnim 0.2s ease-out;
}

@keyframes splatAnim {
  0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1.4); opacity: 0; }
}

.splat-txt {
  font-size: 80rpx;
}

.hit-toast {
  text-align: center;
  font-size: 32rpx;
  font-weight: 900;
  animation: toastFade 0.6s ease-out;
}

@keyframes toastFade {
  0% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-30rpx); }
}

.hit-toast.good { color: #22c55e; }
.hit-toast.bad { color: #ef4444; }

/* 3. 结算界面 */
.gameover-view {
  margin-top: 20rpx;
}

.result-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.3);
}

.result-badge-top {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 800;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.rank-crown {
  font-size: 96rpx;
  margin-bottom: 12rpx;
}

.rank-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 32rpx;
}

.score-spotlight {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.spotlight-num {
  display: block;
  font-size: 68rpx;
  font-weight: 900;
  color: #f59e0b;
}

.spotlight-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
}

.sc-val {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.sc-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--card-border);
  color: var(--text-primary);
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 22rpx 0;
  width: 100%;
}

.back-link {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 10rpx;
}
