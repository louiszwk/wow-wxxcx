<view class="page-container theme-{{theme}}">
  <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <view class="header">
    <view class="title">前沿资讯</view>
    <view class="subtitle">Latest Blue Posts & News</view>
    
    <view class="header-actions">
      <button class="translate-all-btn" bindtap="translateAll" wx:if="{{!isLoading && !hasError && !isTranslatingAll}}">🌐 一键翻译</button>
      <button class="translate-all-btn translating" wx:if="{{isTranslatingAll}}">翻译中...</button>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>
  </view>

  <view class="content">
    <view class="loading-state" wx:if="{{isLoading}}">
      <view class="spinner"></view>
      <text>正在联系燃烧军团...</text>
    </view>
    
    <view class="error-state" wx:if="{{hasError}}">
      <text>数据异常稍后再试</text>
      <button class="retry-btn" bindtap="fetchNews">点击重试</button>
    </view>

    <view class="news-list" wx:if="{{!isLoading && !hasError}}">
      <block wx:for="{{newsList}}" wx:key="link" wx:for-index="index">
        <view class="news-card" bindtap="toggleExpand" data-index="{{index}}">
          <view class="news-header">
            <view class="news-badge {{item.isBluePost ? 'blue-post' : 'normal-news'}}">
              {{'官方新闻'}}
            </view>
            <view class="news-date">{{item.formattedDate}}</view>
          </view>
          
          <view class="news-title">{{item.title}}</view>
          
          <view class="news-snippet {{item.expanded ? 'expanded' : ''}}" wx:if="{{item.contentSnippet}}">
            <text>{{item.contentSnippet}}</text>
          </view>
          
          <view class="news-footer">
            <text class="read-more">{{item.expanded ? '收起详情 ∧' : '阅读摘要 ∨'}}</text>
            <text class="copy-hint" user-select="true" style="max-width: 60%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" catchtap="return">链接(长按复制): {{item.link}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
