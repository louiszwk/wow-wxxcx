.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 20px;
  font-size: 16px;
  cursor: pointer;
}

.back-icon {
  font-size: 24px;
  margin-right: 5px;
  margin-top: -2px;
}

.header {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}

.title-col {
  flex: 1;
  min-width: 0;
  padding-right: 8px;
}

.header-right-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding-top: 2px;
}

button.compact-share-btn,
.compact-share-btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: 44px !important;
  height: 20px !important;
  line-height: 18px !important;
  padding: 0 5px !important;
  margin: 0 4px 0 0 !important;
  font-size: 11px !important;
  font-weight: 500 !important;
  color: #a855f7 !important;
  background: rgba(168, 85, 247, 0.12) !important;
  border: 1px solid rgba(168, 85, 247, 0.35) !important;
  border-radius: 10px !important;
  box-sizing: border-box !important;
  min-height: 0 !important;
}

button.compact-share-btn::after,
.compact-share-btn::after {
  display: none !important;
}

.theme-light button.compact-share-btn,
.theme-light .compact-share-btn {
  color: #7e22ce !important;
  background: rgba(126, 34, 206, 0.1) !important;
  border-color: rgba(126, 34, 206, 0.3) !important;
}

.share-btn-hover {
  opacity: 0.8;
  transform: scale(0.96);
}

.title {
  font-size: 20px;
  font-weight: 800;
  white-space: nowrap;
  background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #7e22ce 0%, #db2777 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 13px;
  color: #94a3b8;
  margin-top: 4px;
}

.theme-light .subtitle {
  color: #475569;
}

.theme-toggle {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 22px;
  padding: 8px;
}

/* Tabs */
.mode-tabs {
  display: flex;
  background: rgba(30, 41, 59, 0.6);
  border-radius: 14px;
  padding: 4px;
  margin-bottom: 16px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.theme-light .mode-tabs {
  background: #dbeafe;
  border: 1px solid #bfdbfe;
}

.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 0;
  font-size: 14px;
  font-weight: 600;
  color: #94a3b8;
  border-radius: 10px;
  transition: all 0.25s ease;
}

.theme-light .mode-tab {
  color: #475569;
}

.mode-tab.active {
  background: #a855f7;
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);
}

.theme-light .mode-tab.active {
  background: #7e22ce;
  color: #ffffff;
}

/* Filter Row */
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}

.filter-chip {
  padding: 6px 14px;
  font-size: 13px;
  border-radius: 20px;
  background: rgba(30, 41, 59, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #94a3b8;
  transition: all 0.2s ease;
}

.theme-light .filter-chip {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
  color: #475569;
}

.filter-chip.active {
  background: #a855f7;
  color: #ffffff;
  border-color: #c084fc;
  font-weight: 600;
}

.theme-light .filter-chip.active {
  background: #7e22ce;
  color: #ffffff;
}

/* Races List */
.races-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.race-card {
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

.theme-light .race-card {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
  box-shadow: 0 4px 16px rgba(180, 205, 230, 0.3);
}

/* 天裔精灵独占酷炫边框效果 */
.celestial-card {
  border: 1.5px solid #c084fc;
  background: linear-gradient(135deg, rgba(88, 28, 135, 0.3) 0%, rgba(30, 41, 59, 0.8) 100%);
  box-shadow: 0 0 20px rgba(192, 132, 252, 0.25);
}

.theme-light .celestial-card {
  border: 1.5px solid #a855f7;
  background: linear-gradient(135deg, #f5f3ff 0%, #e0e7ff 100%);
}

.race-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8px;
}

.race-name {
  font-size: 17px;
  font-weight: 700;
}

.race-faction {
  font-size: 12px;
  color: #38bdf8;
  margin-top: 2px;
}

.theme-light .race-faction {
  color: #0284c7;
}

.race-badge {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.08);
  color: #94a3b8;
}

.celestial-badge {
  background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);
  color: #ffffff;
  font-weight: 700;
}

.race-desc {
  font-size: 13px;
  color: #cbd5e1;
  line-height: 1.5;
  margin-bottom: 12px;
}

.theme-light .race-desc {
  color: #334155;
}

/* Traits Box */
.traits-box {
  background: rgba(15, 23, 42, 0.6);
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 12px;
}

.theme-light .traits-box {
  background: #e8f1f8;
}

.traits-title {
  font-size: 12px;
  font-weight: 700;
  color: #fbbf24;
  margin-bottom: 8px;
}

.theme-light .traits-title {
  color: #b45309;
}

.trait-item {
  font-size: 12px;
  line-height: 1.6;
  margin-bottom: 6px;
}

.trait-name {
  color: #38bdf8;
  font-weight: 600;
}

.theme-light .trait-name {
  color: #0369a1;
}

.trait-desc {
  color: #cbd5e1;
}

.theme-light .trait-desc {
  color: #475569;
}

/* Classes row */
.classes-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
}

.classes-lbl {
  font-size: 12px;
  color: #94a3b8;
}

.theme-light .classes-lbl {
  color: #64748b;
}

.class-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.class-tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.06);
  color: #cbd5e1;
}

.theme-light .class-tag {
  background: #e2e8f0;
  color: #334155;
}

/* Classes Tab */
.classes-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.class-card {
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

.theme-light .class-card {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.class-card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.class-icon-wrapper {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 1px solid;
  display: flex;
  align-items: center;
  justify-content: center;
}

.class-big-icon {
  font-size: 24px;
}

.class-title {
  font-size: 18px;
  font-weight: 800;
}

.class-role {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 2px;
}

.theme-light .class-role {
  color: #64748b;
}

.specs-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 12px;
}

.specs-lbl {
  font-size: 12px;
  color: #94a3b8;
}

.theme-light .specs-lbl {
  color: #64748b;
}

.spec-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.spec-pill {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.06);
  color: #cbd5e1;
}

.theme-light .spec-pill {
  background: #e2e8f0;
  color: #334155;
}

/* Infinite Perk Box */
.infinite-perk-box {
  background: rgba(15, 23, 42, 0.6);
  border-left: 3px solid #a855f7;
  border-radius: 0 10px 10px 0;
  padding: 10px 12px;
}

.theme-light .infinite-perk-box {
  background: #e8f1f8;
  border-left: 3px solid #7e22ce;
}

.perk-title {
  font-size: 12px;
  font-weight: 700;
  color: #c084fc;
  margin-bottom: 4px;
}

.theme-light .perk-title {
  color: #7e22ce;
}

.perk-content {
  font-size: 12px;
  line-height: 1.5;
  color: #cbd5e1;
}

.theme-light .perk-content {
  color: #334155;
}
