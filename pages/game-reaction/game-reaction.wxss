.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 12px;
  font-size: 15px;
  cursor: pointer;
}

.back-icon {
  font-size: 22px;
  margin-right: 4px;
}

.header {
  margin-bottom: 12px;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 22px;
  font-weight: 800;
  background: linear-gradient(135deg, #eab308 0%, #22c55e 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #ca8a04 0%, #16a34a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 2px;
}

.theme-light .subtitle {
  color: #64748b;
}

.theme-toggle {
  font-size: 20px;
  padding: 4px;
}

/* Stage Card (Interactive Area) */
.stage-card {
  flex: 1;
  min-height: 280px;
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px;
  text-align: center;
  box-sizing: border-box;
  margin-bottom: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  transition: all 0.2s ease;
  user-select: none;
}

/* Stage States */
.stage-idle {
  background: rgba(30, 41, 59, 0.7);
  border: 2px dashed rgba(255, 255, 255, 0.15);
}

.theme-light .stage-idle {
  background: #f3f7fc;
  border-color: #cbd5e1;
}

.stage-waiting {
  background: radial-gradient(circle, #b91c1c 0%, #7f1d1d 100%);
  border: 2px solid #ef4444;
  box-shadow: 0 0 30px rgba(239, 68, 68, 0.4);
}

.stage-ready {
  background: radial-gradient(circle, #22c55e 0%, #15803d 100%);
  border: 3px solid #86efac;
  box-shadow: 0 0 40px rgba(34, 197, 94, 0.6);
  animation: flashBurst 0.3s ease;
}

.stage-result {
  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  border: 2px solid #38bdf8;
}

.theme-light .stage-result {
  background: #f3f7fc;
  border-color: #38bdf8;
}

.stage-early {
  background: #450a0a;
  border: 2px solid #ef4444;
}

/* Stage Content */
.stage-icon {
  font-size: 52px;
  margin-bottom: 12px;
}

.stage-main-text {
  font-size: 22px;
  font-weight: 800;
  margin-bottom: 8px;
}

.blast-text {
  font-size: 26px;
  color: #ffffff;
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
}

.early-text {
  color: #f87171;
}

.stage-hint {
  font-size: 13px;
  color: #94a3b8;
}

.theme-light .stage-idle .stage-hint {
  color: #64748b;
}

.warning-hint {
  color: #fecaca;
}

/* Result specifics */
.result-number {
  font-size: 54px;
  font-weight: 900;
  font-family: monospace;
  color: #38bdf8;
  line-height: 1;
  margin-bottom: 10px;
}

.unit {
  font-size: 24px;
  font-weight: 700;
  margin-left: 4px;
}

.result-eval-title {
  font-size: 18px;
  font-weight: 800;
  color: #f59e0b;
  margin-bottom: 6px;
}

.result-eval-desc {
  font-size: 13px;
  color: #94a3b8;
  line-height: 1.5;
  max-width: 280px;
  margin-bottom: 16px;
}

.theme-light .result-eval-desc {
  color: #475569;
}

.tap-again-prompt {
  font-size: 12px;
  color: #38bdf8;
  padding: 4px 12px;
  border-radius: 12px;
  background: rgba(56, 189, 248, 0.15);
}

/* Stats Panel */
.stats-panel {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
}

.stat-box {
  flex: 1;
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 10px 4px;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.theme-light .stat-box {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.stat-label {
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 2px;
}

.theme-light .stat-label {
  color: #64748b;
}

.stat-value {
  font-size: 17px;
  font-weight: 800;
  font-family: monospace;
}

.highlight {
  color: #eab308;
}

/* Recent Trials */
.trials-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 14px;
}

.trials-label {
  font-size: 12px;
  color: #94a3b8;
}

.theme-light .trials-label {
  color: #64748b;
}

.trial-tag {
  font-size: 11px;
  font-family: monospace;
  padding: 2px 8px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 6px;
}

.theme-light .trial-tag {
  background: #e2e8f0;
  color: #334155;
}

.clear-btn {
  font-size: 11px;
  color: #ef4444;
  margin-left: auto;
  padding: 2px 6px;
}

/* Footer Button */
.footer-btn-row {
  margin-bottom: 8px;
}

.share-btn {
  background: linear-gradient(135deg, #eab308 0%, #22c55e 100%);
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  border-radius: 20px;
  border: none;
  padding: 10px 0;
  box-shadow: 0 4px 14px rgba(34, 197, 94, 0.35);
}

@keyframes flashBurst {
  0% { transform: scale(0.96); filter: brightness(1.5); }
  100% { transform: scale(1); filter: brightness(1); }
}

@keyframes pulse {
  0% { transform: scale(0.98); }
  100% { transform: scale(1.02); }
}
