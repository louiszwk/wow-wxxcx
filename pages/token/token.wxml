<view class="page-container theme-{{theme}}">
  <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <view class="header">
    <view class="title">时光徽章</view>
    <view class="subtitle">WoW Token Price</view>
    <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
  </view>

  <view class="content">
    <view class="price-card {{trend}}">
      <view class="region-tabs" style="justify-content: center;">
        <view class="tab active">国服 (CN)</view>
      </view>

      <view class="price-display">
        <view class="price-value">
          <text class="gold {{price.gold === '调用失败' || price.gold === '数据错误' ? 'error' : ''}}">{{price.gold}}</text>
          <text class="unit" wx:if="{{price.gold !== '调用失败' && price.gold !== '数据错误'}}">G</text>
        </view>
        <view class="token-retry-btn" wx:if="{{price.gold === '调用失败' || price.gold === '数据错误'}}" bindtap="refreshData">
          <text class="retry-icon">↻</text>
          <text>点击重试</text>
        </view>
      </view>

      <view class="chart-container">
        <canvas type="2d" id="priceChart" class="price-chart"></canvas>
      </view>

      <view class="update-time">
        <text>最后更新: {{lastUpdated}}</text>
        <view class="refresh-btn {{isRefreshing ? 'spinning' : ''}}" bindtap="refreshData">↻</view>
      </view>
    </view>

    <view class="disclaimer">
      <text>说明: 价格基于全网实时行情抓取。</text>
    </view>
  </view>
</view>
