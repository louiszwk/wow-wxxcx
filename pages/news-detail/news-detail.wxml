<view class="detail-container">
  <view class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">←</text> 返回
    </view>
    <view class="nav-title">资讯详情</view>
  </view>

  <view class="content-wrapper">
    <view class="loading-state" wx:if="{{isLoading}}">
      <view class="spinner"></view>
      <text>正在联系燃烧军团...</text>
    </view>
    
    <view class="error-state" wx:if="{{hasError}}">
      <text>数据异常稍后再试</text>
      <text user-select="true" style="word-break: break-all; margin-top: 20rpx; display: block; font-size: 24rpx; color: #888;">原链接(长按复制): {{link}}</text>
    </view>

    <view class="article-content" wx:if="{{!isLoading && !hasError}}">
      <rich-text nodes="{{htmlContent}}"></rich-text>
    </view>
  </view>
</view>
