.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 12px;
  font-size: 15px;
  cursor: pointer;
}

.back-icon {
  font-size: 22px;
  margin-right: 4px;
}

.header {
  margin-bottom: 12px;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 22px;
  font-weight: 800;
  background: linear-gradient(135deg, #ef4444 0%, #38bdf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #dc2626 0%, #0284c7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 2px;
}

.theme-light .subtitle {
  color: #64748b;
}

.theme-toggle {
  font-size: 20px;
  padding: 4px;
}

/* Top Bar */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.mode-tabs {
  display: flex;
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 3px;
}

.theme-light .mode-tabs {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.tab-item {
  padding: 6px 12px;
  font-size: 12px;
  color: #94a3b8;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.theme-light .tab-item {
  color: #64748b;
}

.tab-item.active {
  background: #3b82f6;
  color: #ffffff;
  font-weight: 700;
}

.turn-box {
  display: flex;
  align-items: center;
}

.turn-desc {
  font-size: 12px;
  color: #94a3b8;
  margin-right: 4px;
}

.theme-light .turn-desc {
  color: #64748b;
}

.turn-tag {
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
}

.horde-tag {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.4);
}

.alliance-tag {
  background: rgba(56, 189, 248, 0.2);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.4);
}

/* 3x3 Grid */
.board-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24px;
}

.grid-3x3 {
  width: 270px;
  height: 270px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  background: rgba(15, 23, 42, 0.85);
  border: 2px solid rgba(239, 68, 68, 0.3);
  border-radius: 16px;
  padding: 8px;
  box-sizing: border-box;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.theme-light .grid-3x3 {
  background: #dbeafe;
  border-color: #93c5fd;
  box-shadow: 0 8px 20px rgba(180, 205, 230, 0.4);
}

.cell {
  width: 78px;
  height: 78px;
  background: rgba(30, 41, 59, 0.8);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 1px 1px 3px rgba(255, 255, 255, 0.08), 0 2px 6px rgba(0, 0, 0, 0.2);
  transition: all 0.2s ease;
}

.theme-light .cell {
  background: #f3f7fc;
  box-shadow: inset 1px 1px 2px rgba(255, 255, 255, 0.6), 0 2px 6px rgba(0, 0, 0, 0.1);
}

.cell:active {
  transform: scale(0.96);
}

.stone-icon {
  font-size: 38px;
  animation: popIn 0.2s ease;
}

.winning-cell {
  background: rgba(245, 158, 11, 0.25) !important;
  border: 2px solid #f59e0b;
  box-shadow: 0 0 16px rgba(245, 158, 11, 0.6) !important;
}

@keyframes popIn {
  0% { transform: scale(0.4); }
  100% { transform: scale(1); }
}

/* Controls */
.controls {
  padding: 0 20px;
  margin-bottom: 16px;
}

.reset-btn {
  background: linear-gradient(135deg, #ef4444 0%, #38bdf8 100%);
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  border-radius: 20px;
  border: none;
  padding: 8px 0;
}

/* Stats */
.stats-panel {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: auto;
  margin-bottom: 8px;
}

.stat-pill {
  font-size: 12px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 10px;
}

.horde-stat {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
}

.draw-stat {
  background: rgba(148, 163, 184, 0.15);
  color: #94a3b8;
}

.alliance-stat {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-card {
  width: 80%;
  background: #1e293b;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 24px 20px;
  text-align: center;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
}

.theme-light .modal-card {
  background: #f3f7fc;
  border: 1px solid #bfdbfe;
  color: #0f2742;
}

.modal-icon {
  font-size: 46px;
  margin-bottom: 8px;
}

.modal-title {
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 8px;
}

.modal-desc {
  font-size: 14px;
  color: #94a3b8;
  margin-bottom: 20px;
  line-height: 1.5;
}

.theme-light .modal-desc {
  color: #475569;
}

.modal-btn-row {
  display: flex;
  gap: 10px;
}

.modal-btn {
  flex: 1;
  font-size: 14px;
  font-weight: 700;
  border-radius: 20px;
  border: none;
  padding: 8px 0;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #ef4444 0%, #38bdf8 100%);
  color: #ffffff;
}

.modal-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.theme-light .modal-btn.secondary {
  background: #e2e8f0;
  border-color: #cbd5e1;
}
