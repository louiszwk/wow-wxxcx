<view class="page-container theme-{{theme}}">
  <!-- Custom Nav Header -->
  <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
    <text class="back-icon">‹</text>
    <text class="back-text">返回游乐场</text>
  </view>

  <!-- Title & Theme Toggle -->
  <view class="header">
    <view class="title-row">
      <view class="title">💣 地精工程排雷营</view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>
    <view class="subtitle">时间就是金钱，朋友！小心脚下 10 颗高爆炸弹！</view>
  </view>

  <!-- Dashboard Top Panel -->
  <view class="control-panel">
    <view class="panel-box">
      <text class="box-label">剩余炸弹</text>
      <text class="box-val red-text">{{flagsLeft}}</text>
    </view>

    <view class="face-btn" bindtap="startNewGame">
      <text class="face-emoji">{{faceIcon}}</text>
    </view>

    <view class="panel-box">
      <text class="box-label">排雷计时</text>
      <text class="box-val cyan-text">{{timer}}s</text>
    </view>
  </view>

  <!-- Mode Toggle (Dig vs Flag) -->
  <view class="mode-bar">
    <view 
      class="mode-pill {{mode === 'dig' ? 'active' : ''}}" 
      data-m="dig" 
      bindtap="toggleMode"
    >
      <text>⛏️ 探雷开路 (点击翻开)</text>
    </view>
    <view 
      class="mode-pill {{mode === 'flag' ? 'active' : ''}}" 
      data-m="flag" 
      bindtap="toggleMode"
    >
      <text>🚩 插旗标记 (长按亦可)</text>
    </view>
  </view>

  <!-- Minefield Grid (9x9) -->
  <view class="grid-container">
    <view class="mine-grid">
      <view 
        wx:for="{{grid}}" 
        wx:for-item="row" 
        wx:for-index="r" 
        wx:key="r" 
        class="grid-row"
      >
        <view 
          wx:for="{{row}}" 
          wx:for-item="cell" 
          wx:for-index="c" 
          wx:key="c" 
          class="cell {{cell.isRevealed ? 'revealed' : ''}} {{cell.isRevealed && cell.isMine ? 'mine-hit' : ''}}"
          data-r="{{r}}"
          data-c="{{c}}"
          bindtap="onCellTap"
          bindlongpress="onCellLongPress"
        >
          <!-- Revealed Mine -->
          <block wx:if="{{cell.isRevealed && cell.isMine}}">
            <text class="cell-icon">💣</text>
          </block>
          <!-- Flagged Cell -->
          <block wx:elif="{{!cell.isRevealed && cell.isFlagged}}">
            <text class="cell-icon flag-icon">🚩</text>
          </block>
          <!-- Revealed Safe Cell -->
          <block wx:elif="{{cell.isRevealed && cell.neighborMines > 0}}">
            <text class="cell-num num-{{cell.neighborMines}}">{{cell.neighborMines}}</text>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- Stats footer -->
  <view class="footer-stats">
    <text class="record-text">最佳记录：{{bestTime < 999 ? bestTime + '秒' : '暂无'}}</text>
  </view>

  <!-- Result Modal -->
  <view class="modal-mask" wx:if="{{status !== 'playing'}}">
    <view class="modal-card">
      <view class="modal-icon">{{status === 'won' ? '🎉' : '💥'}}</view>
      <view class="modal-title">{{status === 'won' ? '地精拆弹大师！' : '轰！踩中引信了！'}}</view>
      <view class="modal-desc">
        {{status === 'won' ? '完美标记全部 10 颗炸弹，用时 ' + timer + ' 秒！' : '地精高爆炸药瞬间引爆，下次探雷记得先看清数字提示！'}}
      </view>
      <view class="modal-btn-row">
        <button class="modal-btn primary" bindtap="startNewGame">再开一局</button>
        <button class="modal-btn secondary" open-type="share">分享战绩</button>
      </view>
    </view>
  </view>
</view>
