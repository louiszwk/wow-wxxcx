<view class="page-container theme-{{theme}}">
  <view class="header" style="padding-top: {{navBarHeight}}px;">
    <view class="hero-section">
      <view class="hero-title-box">
        <view class="theme-toggle" bindtap="toggleTheme">
          <text class="icon">{{theme === 'light' ? '🌙' : '☀️'}}</text>
        </view>
        <view class="title">艾泽拉斯的微风</view>
      </view>
      <view class="subtitle" bindtap="onSubtitleTap">魔兽世界核心向工具箱</view>
    </view>

    <!-- 顶部核心 Tab 栏目: 正式服 / 无限服 -->
    <view class="top-nav-tabs">
      <view class="main-tab-item {{currentTab === 'retail' ? 'active' : ''}}" data-tab="retail" bindtap="switchMainTab">
        <text class="tab-label">正式服</text>
      </view>
      <view class="main-tab-item {{currentTab === 'remix' ? 'active' : ''}}" data-tab="remix" bindtap="switchMainTab">
        <text class="tab-label">无限服</text>
      </view>
    </view>
  </view>

  <!-- ================= TAB 1: 正式服 ================= -->
  <block wx:if="{{currentTab === 'retail'}}">
    <!-- Weekly Dashboard -->
    <view class="dashboard-section">
      <!-- Token Price -->
      <view class="dash-card token-card" bindtap="navigateToToken">
        <view class="dash-info">
          <text class="dash-label">时光徽章 (国服)</text>
          <view class="dash-price-row">
            <text class="dash-value {{tokenError ? 'error-text' : ''}}">{{tokenPrice}}</text>
            <view class="retry-pill" wx:if="{{tokenError}}" catchtap="fetchTokenPrice">
              <text class="retry-icon">↻</text>
              <text>重试</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- Affixes -->
      <view class="dash-card affixes-card">
        <view class="dash-header">
          <text class="dash-title">本周词缀 (国服)</text>
        </view>
        
        <view class="affix-loading" wx:if="{{isLoadingAffixes}}">正在获取...</view>
        <view class="affix-tags" wx:elif="{{affixes.length > 0}}">
          <view class="affix-tag" wx:for="{{affixes}}" wx:key="id">{{item.name}}</view>
        </view>
        <view class="affix-error-row" wx:else>
          <text class="affix-error-text">获取失败</text>
          <view class="retry-pill" catchtap="fetchAffixes">
            <text class="retry-icon">↻</text>
            <text>重试</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Main Navigation Grid -->
    <view class="nav-grid">
      <!-- 1. 大秘境强度榜 -->
      <view class="nav-card" bindtap="navigateToMeta">
        <view class="card-content">
          <view class="card-title">大秘境强度榜</view>
          <view class="card-desc">实时追踪 14+ 层强度评级。</view>
        </view>
      </view>

      <!-- 2. 大米前百数据 -->
      <view class="nav-card" bindtap="navigateToTopMeta">
        <view class="card-content">
          <view class="card-title">大米前百数据</view>
          <view class="card-desc">实时追踪高层大秘境前100名车队阵容与专精出场率。</view>
        </view>
      </view>

      <!-- 3. 第二赛季掉落 -->
      <view class="nav-card" bindtap="navigateToLoot">
        <view class="card-content">
          <view class="card-title">第二赛季掉落</view>
          <view class="card-desc">支持主副属性与装备部位精准筛选。</view>
        </view>
      </view>

      <!-- 4. 大秘境路线 -->
      <view class="nav-card" bindtap="navigateToMdt">
        <view class="card-content">
          <view class="card-title" style="color: #a855f7;">大秘境路线 (Alpha)</view>
          <view class="card-desc">地图交互规划路线与波次，精准计算敌军部队进度。</view>
        </view>
      </view>

      <!-- 5. 魔兽术语与黑话 -->
      <view class="nav-card" bindtap="goToInfiniteTerms">
        <view class="card-content">
          <view class="card-title" style="color: #ec4899;">魔兽术语与黑话</view>
          <view class="card-desc">全网最全魔兽术语与黑话速查！GCD、仇恨OT、顺劈、断条机制全收录。</view>
        </view>
      </view>

      <!-- 6. 宏命令大全 -->
      <view class="nav-card" bindtap="navigateToMacros">
        <view class="card-content">
          <view class="card-title">宏命令大全</view>
          <view class="card-desc">全职业鼠标指向打断、一键爆发、取消保护、极限视距等常用实战宏命令速查。</view>
        </view>
      </view>

      <!-- 配装模拟器 / BiS 毕业装备速查：数据与功能待完善，首页入口暂时隐藏（2026-11-13）。
           页面仍保留在 app.json 中注册，跳转方法 navigateToBuild / navigateToBis 保留在 index.js。
           注意：不要因为「页面已注册但首页没卡片」就自动补入口，需等数据修完并确认后再恢复。
           恢复方式：在此处加两张 nav-card，bindtap 分别为 navigateToBuild、navigateToBis。 -->
    </view>
  </block>

  <!-- ================= TAB 2: 无限服 (Blizzard Project Infinite) ================= -->
  <block wx:if="{{currentTab === 'remix'}}">
    <!-- 无限服 Hero Banner -->
    <view class="remix-hero-banner infinite-hero-banner">
      <view class="remix-glow infinite-glow"></view>
      <view class="remix-badge">BLIZZARD · 暴雪官方无限服 (2026.11.05 上线)</view>
      <view class="remix-title">魔兽世界「无限服」</view>
      <view class="remix-desc">全新60级探索框架 · 天裔中立新种族 · 27系重构天赋 · 9大新地下城与团本</view>
    </view>

    <!-- 无限服 6 大核心功能卡片 -->
    <view class="nav-grid">
      <!-- 1: 世界地图npc航线查询 -->
      <view class="nav-card" bindtap="goToInfiniteMap">
        <view class="card-content">
          <view class="card-title" style="color: #38bdf8;">世界地图与航线查询</view>
          <view class="card-desc">泽风岛新手区、海加尔山区与经典航线NPC速查，支持路线规划与坐标宏复制。</view>
        </view>
      </view>

      <!-- 2: 天赋模拟器 -->
      <view class="nav-card" bindtap="goToInfiniteTalents">
        <view class="card-content">
          <view class="card-title" style="color: #f59e0b;">60级天赋模拟器</view>
          <view class="card-desc">全职业三系经典与无限分支天赋树加点模拟，支持51点加点规划与方案导出。</view>
        </view>
      </view>

      <!-- 3: 种族、职业介绍 -->
      <view class="nav-card" bindtap="goToInfiniteClasses">
        <view class="card-content">
          <view class="card-title" style="color: #a855f7;">种族与职业介绍</view>
          <view class="card-desc">官方中立全新种族【天裔】双阵营特长、风暴德鲁伊形态与职业机制速览。</view>
        </view>
      </view>

      <!-- 4: 首发地下城与团本 -->
      <view class="nav-card" bindtap="goToInfiniteDungeons">
        <view class="card-content">
          <view class="card-title" style="color: #ef4444;">首发地下城与团本速查</view>
          <view class="card-desc">9大全新5人地下城机制与12月10日首发三大团本（深穴、海加尔峰、黑龙MM）全览。</view>
        </view>
      </view>

      <!-- 5: 许愿 -->
      <view class="nav-card" bindtap="goToInfiniteWishes">
        <view class="card-content">
          <view class="card-title" style="color: #fbbf24;">艾泽拉斯祈愿池</view>
          <view class="card-desc">向圣泉投掷金币许下毕业心愿！风剑、提布、凤凰坐骑欧气祈福与全服祝福互动墙。</view>
        </view>
      </view>

      <!-- 6: 魔兽术语板块 -->
      <view class="nav-card" bindtap="goToInfiniteTerms">
        <view class="card-content">
          <view class="card-title" style="color: #ec4899;">魔兽术语与黑话</view>
          <view class="card-desc">全网最全魔兽术语与黑话速查！GCD、仇恨OT、顺劈、钢条断条、减伤链全收录。</view>
        </view>
      </view>
    </view>
  </block>


  
  <view class="footer">
    <text>Data Driven World of Warcraft</text>
  </view>
</view>
