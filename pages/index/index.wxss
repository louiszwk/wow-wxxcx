/* ================= 浅色主题变量 (淡蓝柔和护眼色调) ================= */
.theme-light {
  --bg-color: #e8f1f8; /* 柔和浅淡冰蓝底色，不刺眼 */
  --card-bg: #f3f7fc; /* 浅淡清爽冰蓝卡片背景，告别纯白晃眼 */
  --text-primary: #0f2742; /* 深海蓝黑色高清晰文字 */
  --text-secondary: #4a6885; /* 柔和蓝灰次要说明文字 */
  --icon-bg: #d7e7f5;
  --border-color: #cde0f0; /* 柔和冰霜蓝边框 */
}

/* ================= 深色主题变量 ================= */
.theme-dark {
  --bg-color: #111827; /* Tailwind gray-900 */
  --card-bg: #1f2937; /* Tailwind gray-800 */
  --text-primary: #f9fafb;
  --text-secondary: #9ca3af;
  --icon-bg: #374151;
  --border-color: #374151;
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
  position: relative;
}

.header {
  padding: 0 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-top: 8rpx;
}

.hero-title-box {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 72rpx;
}

.theme-toggle {
  position: absolute;
  left: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  width: 68rpx;
  height: 68rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  z-index: 10;
}

.theme-toggle:active {
  transform: translateY(-50%) scale(0.9);
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 25rpx rgba(139, 92, 246, 0.4);
}

.logo-icon {
  font-size: 80rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 0;
  letter-spacing: 2rpx;
  line-height: 1.2;
  text-align: center;
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}

/* 顶部核心 Tab (正式服 / 无限服 / 游乐场) */
.top-nav-tabs {
  display: flex;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 40rpx;
  padding: 8rpx;
  margin-top: 24rpx;
  width: 90%;
  max-width: 650rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.main-tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-secondary);
  transition: all 0.25s ease;
  position: relative;
}

.main-tab-item.active {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(59, 130, 246, 0.4);
}

.tab-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.2);
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  margin-left: 8rpx;
}

.main-tab-item.active .tab-badge {
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.game-badge-pill {
  color: #f472b6;
  background: rgba(244, 114, 182, 0.2);
}

/* Dashboard Section */
.dashboard-section {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.dash-card {
  flex: 1;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx -4rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 180rpx;
  box-sizing: border-box;
  transition: all 0.2s;
}

.dash-card:active {
  transform: scale(0.98);
}

.token-card {
  align-items: flex-start;
}

.dash-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.dash-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.dash-price-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dash-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #fbbf24;
}

.dash-value.error-text {
  font-size: 26rpx;
  color: #f87171;
  font-weight: 600;
}

/* Affixes Card */
.affixes-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dash-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.dash-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.affix-loading {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.affix-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.affix-tag {
  background: var(--bg-color);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  text-align: center;
}

.affix-error-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0;
}

.affix-error-text {
  font-size: 24rpx;
  color: #f87171;
  font-weight: 600;
}

.retry-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(248, 113, 113, 0.15);
  border: 1px solid rgba(248, 113, 113, 0.3);
  color: #f87171;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  transition: all 0.2s;
}

.retry-pill:active {
  transform: scale(0.92);
  background: rgba(248, 113, 113, 0.25);
}

.retry-icon {
  font-size: 20rpx;
}

.nav-grid {
  flex: 1;
  padding: 0 40rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx;
}

.nav-card {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 32rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 0 8rpx 20rpx -4rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.nav-card:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 10rpx -2rpx rgba(0, 0, 0, 0.1);
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--icon-bg);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
  width: 100%;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.card-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-title-row .card-title {
  margin-bottom: 0;
}

.game-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: #ec4899;
  background: rgba(236, 72, 153, 0.15);
  border: 1rpx solid rgba(236, 72, 153, 0.3);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  margin-left: 8rpx;
}

.highlight-game-card {
  border: 1rpx solid rgba(236, 72, 153, 0.3) !important;
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.05), transparent 70%), var(--card-bg) !important;
}

/* Remix Banner */
.remix-hero-banner {
  margin: 0 40rpx 40rpx;
  background: linear-gradient(135deg, #0f172a, #1e1b4b);
  border: 1rpx solid rgba(168, 85, 247, 0.35);
  border-radius: 28rpx;
  padding: 36rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.25);
}

.remix-glow {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(168, 85, 247, 0.5), transparent 70%);
  filter: blur(30rpx);
  pointer-events: none;
}

.remix-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 800;
  color: #c084fc;
  background: rgba(168, 85, 247, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(168, 85, 247, 0.3);
}

.remix-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.remix-desc {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.theme-light .remix-hero-banner {
  background: linear-gradient(135deg, #e0f2fe, #ede9fe);
  border: 1rpx solid #c7d2fe;
}

.theme-light .remix-title {
  color: #1e1b4b;
}

.theme-light .remix-desc {
  color: #475569;
}

.theme-light .arcade-hero-banner {
  background: linear-gradient(135deg, #fce7f3, #e0e7ff);
  border: 1rpx solid #fbcfe8;
}

.theme-light .arcade-title {
  color: #831843;
}

.theme-light .arcade-desc {
  color: #475569;
}

.arcade-hero-banner {
  margin: 0 40rpx 40rpx;
  background: linear-gradient(135deg, #090d16, #1e1b4b);
  border: 1rpx solid rgba(236, 72, 153, 0.35);
  border-radius: 28rpx;
  padding: 36rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.25);
}

.arcade-glow {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(236, 72, 153, 0.5), transparent 70%);
  filter: blur(30rpx);
  pointer-events: none;
}

.arcade-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 800;
  color: #f472b6;
  background: rgba(236, 72, 153, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(236, 72, 153, 0.3);
  margin-bottom: 12rpx;
}

.arcade-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.arcade-desc {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.game-item-card {
  border-color: rgba(255, 255, 255, 0.08);
}

.footer {
  text-align: center;
  padding: 60rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
  opacity: 0.7;
}
