<view class="page-container theme-{{theme}}">
  <!-- Custom Nav Header -->
  <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
    <text class="back-icon">‹</text>
    <text class="back-text">返回游乐场</text>
  </view>

  <!-- Title & Theme Toggle -->
  <view class="header">
    <view class="title-row">
      <view class="title">🔨 圣光之锤打砖块</view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>
    <view class="subtitle">滑动圣盾反弹圣光飞锤 · 击碎天灾魔石与炸药桶</view>
  </view>

  <!-- Dashboard -->
  <view class="dashboard">
    <view class="dash-box">
      <text class="dash-label">当前得分</text>
      <text class="dash-val highlight">{{score}}</text>
    </view>
    <view class="dash-box">
      <text class="dash-label">关卡难度</text>
      <text class="dash-val">第 {{level}} 波</text>
    </view>
    <view class="dash-box">
      <text class="dash-label">圣盾生命</text>
      <view class="hearts-row">
        <text wx:for="{{[1,2,3]}}" wx:key="*this" class="heart-icon">{{item <= lives ? '❤️' : '🖤'}}</text>
      </view>
    </view>
    <view class="dash-box">
      <text class="dash-label">历史最高</text>
      <text class="dash-val">{{bestScore}}</text>
    </view>
  </view>

  <!-- Canvas Game Container -->
  <view class="canvas-container" touchmove="onTouchMove" bindtouchmove="onTouchMove" bindtouchstart="onTouchMove">
    <canvas 
      type="2d" 
      id="breakoutCanvas" 
      class="game-canvas" 
      style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
    ></canvas>

    <!-- Overlay when Ready to start -->
    <view class="canvas-overlay" wx:if="{{gameState === 'ready'}}" bindtap="startGame">
      <view class="overlay-icon">⚡</view>
      <view class="overlay-title">点击屏幕发射圣锤</view>
      <view class="overlay-desc">左右拖动底部圣盾接球反弹</view>
    </view>
  </view>

  <!-- Control Buttons -->
  <view class="controls">
    <button class="action-btn" wx:if="{{gameState === 'ready'}}" bindtap="startGame">发射圣光飞锤</button>
    <button class="action-btn restart-btn" wx:else bindtap="resetGame">重新开局</button>
  </view>

  <!-- Game Over Modal -->
  <view class="modal-mask" wx:if="{{gameState === 'over'}}">
    <view class="modal-card">
      <view class="modal-icon">💀</view>
      <view class="modal-title">圣盾碎裂！游戏结束</view>
      <view class="modal-desc">天灾魔石最终斩获：<text class="score-num">{{score}}</text> 分</view>
      <view class="modal-btn-row">
        <button class="modal-btn primary" bindtap="resetGame">重铸圣盾再战</button>
        <button class="modal-btn secondary" open-type="share">分享战报</button>
      </view>
    </view>
  </view>
</view>
