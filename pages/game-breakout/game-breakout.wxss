.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 12px;
  font-size: 15px;
  cursor: pointer;
}

.back-icon {
  font-size: 22px;
  margin-right: 4px;
}

.header {
  margin-bottom: 12px;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 22px;
  font-weight: 800;
  background: linear-gradient(135deg, #f59e0b 0%, #38bdf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #d97706 0%, #0284c7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 2px;
}

.theme-light .subtitle {
  color: #64748b;
}

.theme-toggle {
  font-size: 20px;
  padding: 4px;
}

/* Dashboard */
.dashboard {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.dash-box {
  flex: 1;
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 8px 4px;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.theme-light .dash-box {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.dash-label {
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 2px;
}

.theme-light .dash-label {
  color: #64748b;
}

.dash-val {
  font-size: 15px;
  font-weight: 800;
}

.highlight {
  color: #f59e0b;
}

.hearts-row {
  display: flex;
  justify-content: center;
  gap: 2px;
}

.heart-icon {
  font-size: 12px;
}

/* Canvas Container */
.canvas-container {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 12px;
}

.game-canvas {
  background: rgba(15, 23, 42, 0.85);
  border: 2px solid rgba(245, 158, 11, 0.3);
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.theme-light .game-canvas {
  background: #dbeafe;
  border-color: #93c5fd;
  box-shadow: 0 8px 20px rgba(180, 205, 230, 0.4);
}

.canvas-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.6);
  border-radius: 16px;
  backdrop-filter: blur(2px);
}

.theme-light .canvas-overlay {
  background: rgba(224, 242, 254, 0.7);
}

.overlay-icon {
  font-size: 40px;
  margin-bottom: 8px;
}

.overlay-title {
  font-size: 18px;
  font-weight: 800;
  color: #f59e0b;
  margin-bottom: 4px;
}

.overlay-desc {
  font-size: 13px;
  color: #94a3b8;
}

.theme-light .overlay-desc {
  color: #475569;
}

/* Controls */
.controls {
  padding: 0 16px;
  margin-top: auto;
  margin-bottom: 8px;
}

.action-btn {
  background: linear-gradient(135deg, #f59e0b 0%, #38bdf8 100%);
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  border-radius: 20px;
  border: none;
  padding: 8px 0;
  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
}

.restart-btn {
  background: rgba(255, 255, 255, 0.1);
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.theme-light .restart-btn {
  background: #f3f7fc;
  border-color: #cbd5e1;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-card {
  width: 80%;
  background: #1e293b;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 24px 20px;
  text-align: center;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
}

.theme-light .modal-card {
  background: #f3f7fc;
  border: 1px solid #bfdbfe;
  color: #0f2742;
}

.modal-icon {
  font-size: 46px;
  margin-bottom: 8px;
}

.modal-title {
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 8px;
}

.modal-desc {
  font-size: 14px;
  color: #94a3b8;
  margin-bottom: 20px;
}

.theme-light .modal-desc {
  color: #475569;
}

.score-num {
  font-size: 18px;
  font-weight: 800;
  color: #f59e0b;
}

.modal-btn-row {
  display: flex;
  gap: 10px;
}

.modal-btn {
  flex: 1;
  font-size: 14px;
  font-weight: 700;
  border-radius: 20px;
  border: none;
  padding: 8px 0;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #f59e0b 0%, #38bdf8 100%);
  color: #ffffff;
}

.modal-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.theme-light .modal-btn.secondary {
  background: #e2e8f0;
  border-color: #cbd5e1;
}
