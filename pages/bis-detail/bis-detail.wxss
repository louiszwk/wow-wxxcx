.page-container {
  min-height: 100vh;
  background-color: #1a1b2e;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #232540;
  position: relative;
  padding-bottom: 10px;
}
.nav-back {
  position: absolute;
  left: 15px;
  display: flex;
  align-items: center;
  bottom: 10px;
}
.back-icon {
  font-size: 28px;
  color: #fff;
}
.nav-title {
  font-size: 16px;
  font-weight: bold;
  letter-spacing: 2px;
}

.time-limit {
  background-color: #0099ff;
  color: #fff;
  text-align: center;
  font-size: 12px;
  padding: 4px 0;
  font-weight: bold;
}

.banner-img {
  width: 100%;
  height: 40px;
  display: block;
}

.tabs-container {
  background-color: #2a2c4a;
  padding: 10px 0;
  border-bottom: 1px solid #36395e;
}

.spec-tabs {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-bottom: 10px;
}
.spec-tab {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 4px 15px;
  background: rgba(0,0,0,0.3);
  border: 1px solid #4a4d7a;
  border-radius: 4px;
  font-size: 14px;
  color: #8f95c4;
}
.spec-tab.active {
  border-color: #ff9900;
  color: #ff9900;
  background: rgba(255, 153, 0, 0.1);
}
.spec-icon {
  width: 20px;
  height: 20px;
  border-radius: 2px;
}

.mode-tabs {
  display: flex;
  justify-content: center;
  gap: 15px;
}
.mode-tab {
  font-size: 13px;
  padding: 4px 15px;
  border: 1px solid transparent;
  color: #fff;
}
.mode-tab.active {
  background-color: #e67e22;
  border-radius: 4px;
  font-weight: bold;
}
.mode-tab:not(.active) {
  border: 1px solid #5a5d8a;
  border-radius: 4px;
  color: #a4a7c8;
}

/* 装备面板 */
.gear-panel {
  display: flex;
  justify-content: space-between;
  padding: 15px 10px;
  background-image: url('https://wow.zamimg.com/images/wow/icons/large/class_deathknight.jpg');
  background-size: cover;
  background-position: center;
  background-blend-mode: overlay;
  background-color: rgba(26, 27, 46, 0.95);
}

.gear-col {
  width: 48%;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.gear-item {
  display: flex;
  align-items: center;
  gap: 8px;
}
.gear-item.reverse {
  flex-direction: row-reverse;
  text-align: right;
}

.gear-icon {
  width: 36px;
  height: 36px;
  border: 1px solid #a335ee;
  border-radius: 4px;
  flex-shrink: 0;
}
.gear-empty-icon {
  width: 36px;
  height: 36px;
  border: 1px solid #555;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #555;
  background: #111;
  font-weight: bold;
  flex-shrink: 0;
}

.gear-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.gear-name {
  font-size: 12px;
  font-weight: bold;
  margin-bottom: 2px;
  white-space: nowrap;
}
.epic-text {
  color: #a335ee;
}

.gear-desc {
  font-size: 10px;
  color: #a4a7c8;
  white-space: nowrap;
}

/* 底部武器栏 */
.weapons-panel {
  display: flex;
  justify-content: center;
  gap: 20px;
  padding: 0 15px 15px;
}
.weapons-panel .gear-item {
  width: 45%;
}

/* 底部属性栏 */
.stats-panel {
  text-align: center;
  padding: 15px;
  background: rgba(0,0,0,0.3);
  margin-top: 10px;
}
.stats-title {
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 8px;
  color: #fff;
}
.stats-row {
  display: flex;
  justify-content: center;
  gap: 8px;
  font-size: 12px;
  margin-bottom: 5px;
}
.stat-crit { color: #ff3333; }
.stat-haste { color: #ffcc00; }
.stat-mastery { color: #3399ff; }
.stat-vers { color: #cc66ff; }
.stats-total {
  font-size: 14px;
  color: #00ff00;
  font-weight: bold;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300px;
  color: #a335ee;
  font-size: 14px;
  text-align: center;
  background-color: rgba(26, 27, 46, 0.95);
}

.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 300px;
  background-color: rgba(26, 27, 46, 0.95);
  gap: 15px;
}
.empty-icon {
  font-size: 40px;
  opacity: 0.6;
}
.empty-text {
  color: #8f95c4;
  font-size: 14px;
  text-align: center;
  line-height: 1.6;
}

.guide-panel {
  padding: 15px;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.panel-card {
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 15px;
}

.card-title {
  font-size: 15px;
  font-weight: 700;
  color: #fbbf24;
  margin-bottom: 10px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  padding-bottom: 8px;
}

.talent-box {
  display: flex;
  gap: 10px;
  align-items: center;
}

.talent-code {
  flex: 1;
  background: rgba(0,0,0,0.3);
  padding: 10px;
  border-radius: 8px;
  font-size: 12px;
  color: #94a3b8;
  word-break: break-all;
}

.copy-btn {
  background: #3b82f6;
  color: #fff;
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  flex-shrink: 0;
}
.copy-btn:active {
  background: #2563eb;
}

.talent-desc {
  font-size: 12px;
  color: #cbd5e1;
  margin-top: 8px;
  line-height: 1.5;
}

.consumable-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.c-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,0.05);
  padding: 10px;
  border-radius: 8px;
}
.c-label {
  color: #94a3b8;
  font-size: 13px;
}
.c-val {
  color: #f8fafc;
  font-size: 13px;
  font-weight: 600;
}

.rotation-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.rot-item {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(0,0,0,0.2);
  padding: 12px;
  border-radius: 10px;
  border-left: 4px solid #3b82f6;
}
.rot-icon {
  width: 36px;
  height: 36px;
  border-radius: 6px;
  border: 1px solid #3b82f6;
  flex-shrink: 0;
}
.rot-step {
  width: 24px;
  height: 24px;
  background: #3b82f6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 12px;
}
.rot-info {
  flex: 1;
}
.rot-name {
  font-size: 14px;
  font-weight: 700;
  color: #f8fafc;
}
.rot-desc {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 4px;
}

.gear-slot-tag {
  background: rgba(255,255,255,0.1);
  padding: 4px 6px;
  border-radius: 4px;
  font-size: 11px;
  color: #cbd5e1;
  font-weight: 600;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.retry-btn-guide {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #3b82f6;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
  transition: all 0.2s;
}

.retry-btn-guide:active {
  transform: scale(0.95);
  opacity: 0.9;
}
