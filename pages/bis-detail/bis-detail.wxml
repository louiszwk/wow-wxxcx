<view class="page-container">
  <view class="nav-bar" style="padding-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px;">
    <view class="nav-back" bindtap="navigateBack" style="height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px; display: flex; align-items: center;">
      <text class="back-icon" style="font-size: 28px;">‹</text>
    </view>
    <view class="nav-title" style="line-height: {{menuButtonHeight}}px;">{{className}}</view>
  </view>

  <view class="banner-area">
    <view class="time-limit">12.1.5 · 官方客户端物品数据 · 2026-11-13</view>
    <!-- 顶部背景图，可以用死亡骑士的职业背景替代 -->
    <image class="banner-img" src="https://wow.zamimg.com/images/wow/icons/large/class_deathknight.jpg" mode="aspectFill"></image>
  </view>

  <view class="tabs-container">
    <view class="spec-tabs">
      <block wx:for="{{specs}}" wx:key="id">
        <view class="spec-tab {{activeSpec === index ? 'active' : ''}}" bindtap="switchSpec" data-index="{{index}}">
          <text>{{item.name}}</text>
        </view>
      </block>
    </view>

    <view class="mode-tabs">
      <block wx:for="{{sectionTabs}}" wx:key="*this">
        <view class="mode-tab {{activeSection === index ? 'active' : ''}}" bindtap="switchSection" data-index="{{index}}">
          <text>{{item}}</text>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="loading-state">
    <text>正在载入官方 BiS 数据...</text>
  </view>

  <view wx:elif="{{!guideData}}" class="empty-state">
    <view class="empty-icon">📂</view>
    <text class="empty-text">该专精暂无可核实的 BiS 数据\n请从 BiS 列表重新选择职业专精</text>
    <view class="retry-btn-guide" bindtap="fetchDynamicBisGear">
      <text class="retry-icon">↻</text>
      <text>点击重试</text>
    </view>
  </view>

  <view wx:else>
    <!-- Section 0: 天赋代码（只展示可核实数据，缺失一律留空） -->
    <view class="guide-panel" wx:if="{{activeSection === 0}}">
      <view class="panel-card" wx:if="{{guideData.talents && guideData.talents.mythicPlus}}">
        <view class="card-title">大秘境天赋代码</view>
        <view class="talent-box">
          <text class="talent-code" user-select="true">{{guideData.talents.mythicPlus}}</text>
          <view class="copy-btn" bindtap="copyTalent" data-code="{{guideData.talents.mythicPlus}}">一键复制</view>
        </view>
        <view class="talent-desc" wx:if="{{guideData.talents.mythicPlusName}}">{{guideData.talents.mythicPlusName}}</view>
      </view>

      <view class="panel-card" wx:if="{{guideData.talents && guideData.talents.raid}}">
        <view class="card-title">团本天赋代码</view>
        <view class="talent-box">
          <text class="talent-code" user-select="true">{{guideData.talents.raid}}</text>
          <view class="copy-btn" bindtap="copyTalent" data-code="{{guideData.talents.raid}}">一键复制</view>
        </view>
        <view class="talent-desc" wx:if="{{guideData.talents.raidName}}">{{guideData.talents.raidName}}</view>
        <view class="talent-desc" wx:if="{{guideData.talents.desc}}">{{guideData.talents.desc}}</view>
      </view>

      <view class="panel-card" wx:if="{{!guideData.talents || (!guideData.talents.mythicPlus && !guideData.talents.raid)}}">
        <view class="card-title">天赋代码</view>
        <view class="talent-desc">暂无可核实的天赋代码，留空待补。</view>
      </view>
    </view>

    <!-- Section 1: 输出手法（无数据则留空） -->
    <view class="guide-panel" wx:if="{{activeSection === 1}}">
      <view class="panel-card" wx:if="{{guideData.rotation.length > 0}}">
        <view class="card-title">输出优先级 (自上而下)</view>
        <view class="rotation-list">
          <view class="rot-item" wx:for="{{guideData.rotation}}" wx:key="name">
            <image class="rot-icon" wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFill"></image>
            <view class="rot-step" wx:else>{{index + 1}}</view>
            <view class="rot-info">
              <view class="rot-name">{{item.name}}</view>
              <view class="rot-desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </view>
      <view class="panel-card" wx:if="{{!guideData.rotation || guideData.rotation.length === 0}}">
        <view class="card-title">输出手法</view>
        <view class="talent-desc">暂无可核实的输出手法，留空待补。</view>
      </view>
    </view>

    <!-- Section 2: BiS装备（物品名与属性来自官方客户端） -->
    <view class="guide-panel" wx:if="{{activeSection === 2}}">
      <view class="gear-panel">
        <view class="gear-col left-col">
          <block wx:for="{{leftGear}}" wx:key="slot">
            <view class="gear-item {{item.quality === 'empty' ? 'empty-slot' : ''}}" bindtap="openItemStats" data-name="{{item.name}}">
              <image class="gear-icon" wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFill"></image>
              <view class="gear-slot-tag">{{item.slot}}</view>
              <view class="gear-info" wx:if="{{item.name}}">
                <view class="gear-name epic-text">{{item.name}}</view>
                <view class="gear-desc">{{item.desc}}</view>
              </view>
            </view>
          </block>
        </view>

        <view class="gear-col right-col">
          <block wx:for="{{rightGear}}" wx:key="slot">
            <view class="gear-item reverse {{item.quality === 'empty' ? 'empty-slot' : ''}}" bindtap="openItemStats" data-name="{{item.name}}">
              <image class="gear-icon" wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFill"></image>
              <view class="gear-slot-tag">{{item.slot}}</view>
              <view class="gear-info" wx:if="{{item.name}}">
                <view class="gear-name epic-text">{{item.name}}</view>
                <view class="gear-desc">{{item.desc}}</view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="weapons-panel">
        <block wx:for="{{weapons}}" wx:key="slot">
          <view class="gear-item {{item.quality === 'empty' ? 'empty-slot' : ''}}" bindtap="openItemStats" data-name="{{item.name}}">
            <image class="gear-icon" wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFill"></image>
            <view class="gear-slot-tag">{{item.slot}}</view>
            <view class="gear-info" wx:if="{{item.name}}">
              <view class="gear-name epic-text">{{item.name}}</view>
              <view class="gear-desc">{{item.desc}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>

</view>
