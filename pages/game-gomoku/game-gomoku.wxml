<view class="page-container theme-{{theme}}">
  <!-- Custom Nav Header -->
  <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
    <text class="back-icon">‹</text>
    <text class="back-text">返回游乐场</text>
  </view>

  <!-- Title & Theme Toggle -->
  <view class="header">
    <view class="title-row">
      <view class="title">⚔️ 战歌五子棋</view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>
    <view class="subtitle">阵营博弈 · 部落(黑红) vs 联盟(湛蓝) · 5子连线即胜</view>
  </view>

  <!-- Mode Selector & Turn Indicator -->
  <view class="top-bar">
    <view class="mode-tabs">
      <view 
        class="tab-item {{vsMode === 'ai' ? 'active' : ''}}" 
        data-mode="ai" 
        bindtap="switchMode"
      >
        <text>人机挑战 (AI)</text>
      </view>
      <view 
        class="tab-item {{vsMode === 'pvp' ? 'active' : ''}}" 
        data-mode="pvp" 
        bindtap="switchMode"
      >
        <text>双人同屏 (PvP)</text>
      </view>
    </view>

    <!-- Turn Banner -->
    <view class="turn-banner">
      <text class="turn-label">当前落子：</text>
      <view class="turn-indicator {{currentPlayer === 1 ? 'turn-horde' : 'turn-alliance'}}">
        <text class="turn-icon">{{currentPlayer === 1 ? '⚔️ 部落' : '🛡️ 联盟'}}</text>
      </view>
    </view>
  </view>

  <!-- Gomoku Board (11x11) -->
  <view class="board-wrapper">
    <view class="board-grid">
      <view 
        wx:for="{{board}}" 
        wx:for-item="row" 
        wx:for-index="r" 
        wx:key="r" 
        class="board-row"
      >
        <view 
          wx:for="{{row}}" 
          wx:for-item="cell" 
          wx:for-index="c" 
          wx:key="c" 
          class="grid-cell {{lastMove && lastMove.r === r && lastMove.c === c ? 'last-move' : ''}}"
          data-r="{{r}}"
          data-c="{{c}}"
          bindtap="onCellTap"
        >
          <!-- Grid cross lines -->
          <view class="line-h"></view>
          <view class="line-v"></view>

          <!-- Pieces -->
          <view class="stone horde-stone" wx:if="{{cell === 1}}">
            <text class="stone-icon">⚔️</text>
          </view>
          <view class="stone alliance-stone" wx:elif="{{cell === 2}}">
            <text class="stone-icon">🛡️</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Action Controls -->
  <view class="action-row">
    <button class="ctrl-btn undo-btn" bindtap="undoMove" disabled="{{moveHistory.length === 0}}">
      <text>↩ 悔棋一步</text>
    </button>
    <button class="ctrl-btn reset-btn" bindtap="initBoard">
      <text>🔄 重新开局</text>
    </button>
  </view>

  <!-- Win Stats -->
  <view class="stats-panel">
    <view class="stat-pill horde-stat">部落胜场：{{stats.hordeWins}}</view>
    <view class="stat-pill alliance-stat">联盟胜场：{{stats.allianceWins}}</view>
  </view>

  <!-- Victory Modal -->
  <view class="modal-mask" wx:if="{{status === 'won'}}">
    <view class="modal-card">
      <view class="modal-icon">{{winner === 1 ? '⚔️' : '🛡️'}}</view>
      <view class="modal-title">{{winner === 1 ? '为了部落！斩获胜利！' : '为了联盟！获得胜利！'}}</view>
      <view class="modal-desc">
        {{winner === 1 ? '奥格瑞玛的号角响彻云霄，部落先手五子连珠！' : '暴风城的圣光护佑棋盘，联盟绝妙布局力克强敌！'}}
      </view>
      <view class="modal-btn-row">
        <button class="modal-btn primary" bindtap="initBoard">再战一局</button>
        <button class="modal-btn secondary" open-type="share">分享棋局</button>
      </view>
    </view>
  </view>
</view>
