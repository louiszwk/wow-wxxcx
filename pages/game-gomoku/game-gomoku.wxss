.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 12px;
  font-size: 15px;
  cursor: pointer;
}

.back-icon {
  font-size: 22px;
  margin-right: 4px;
}

.header {
  margin-bottom: 12px;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 22px;
  font-weight: 800;
  background: linear-gradient(135deg, #ef4444 0%, #38bdf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #dc2626 0%, #0284c7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 2px;
}

.theme-light .subtitle {
  color: #64748b;
}

.theme-toggle {
  font-size: 20px;
  padding: 4px;
}

/* Top Bar */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.mode-tabs {
  display: flex;
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 3px;
}

.theme-light .mode-tabs {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.tab-item {
  padding: 6px 12px;
  font-size: 12px;
  color: #94a3b8;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.theme-light .tab-item {
  color: #64748b;
}

.tab-item.active {
  background: #3b82f6;
  color: #ffffff;
  font-weight: 700;
}

.turn-banner {
  display: flex;
  align-items: center;
}

.turn-label {
  font-size: 12px;
  color: #94a3b8;
  margin-right: 4px;
}

.theme-light .turn-label {
  color: #64748b;
}

.turn-indicator {
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
}

.turn-horde {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.4);
}

.turn-alliance {
  background: rgba(56, 189, 248, 0.2);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.4);
}

/* Board (11x11) */
.board-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 14px;
}

.board-grid {
  background: #e2c290;
  border: 3px solid #8b5a2b;
  border-radius: 12px;
  padding: 4px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.theme-light .board-grid {
  background: #f5dfb8;
  border-color: #a06b3a;
  box-shadow: 0 8px 20px rgba(180, 205, 230, 0.4);
}

.board-row {
  display: flex;
}

.grid-cell {
  width: 29px;
  height: 29px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Cross lines */
.line-h {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: #8b5a2b;
  transform: translateY(-50%);
}

.line-v {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1px;
  background: #8b5a2b;
  transform: translateX(-50%);
}

.grid-cell.last-move::after {
  content: '';
  position: absolute;
  width: 6px;
  height: 6px;
  background: #fbbf24;
  border-radius: 50%;
  z-index: 5;
}

/* Stones */
.stone {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 1px 2px 4px rgba(0, 0, 0, 0.4);
  animation: dropStone 0.15s ease-out;
}

.stone-icon {
  font-size: 13px;
}

.horde-stone {
  background: radial-gradient(circle at 30% 30%, #ef4444 0%, #7f1d1d 100%);
  border: 1px solid #450a0a;
}

.alliance-stone {
  background: radial-gradient(circle at 30% 30%, #38bdf8 0%, #1e3a8a 100%);
  border: 1px solid #172554;
}

@keyframes dropStone {
  0% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* Actions */
.action-row {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}

.ctrl-btn {
  flex: 1;
  font-size: 14px;
  font-weight: 700;
  border-radius: 18px;
  border: none;
  padding: 8px 0;
}

.undo-btn {
  background: rgba(255, 255, 255, 0.1);
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.theme-light .undo-btn {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.reset-btn {
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  color: #ffffff;
}

/* Stats */
.stats-panel {
  display: flex;
  justify-content: center;
  gap: 16px;
  margin-top: auto;
  margin-bottom: 8px;
}

.stat-pill {
  font-size: 12px;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 12px;
}

.horde-stat {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
}

.alliance-stat {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-card {
  width: 80%;
  background: #1e293b;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 24px 20px;
  text-align: center;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
}

.theme-light .modal-card {
  background: #f3f7fc;
  border: 1px solid #bfdbfe;
  color: #0f2742;
}

.modal-icon {
  font-size: 46px;
  margin-bottom: 8px;
}

.modal-title {
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 8px;
}

.modal-desc {
  font-size: 14px;
  color: #94a3b8;
  margin-bottom: 20px;
  line-height: 1.5;
}

.theme-light .modal-desc {
  color: #475569;
}

.modal-btn-row {
  display: flex;
  gap: 10px;
}

.modal-btn {
  flex: 1;
  font-size: 14px;
  font-weight: 700;
  border-radius: 20px;
  border: none;
  padding: 8px 0;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #ef4444 0%, #38bdf8 100%);
  color: #ffffff;
}

.modal-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.theme-light .modal-btn.secondary {
  background: #e2e8f0;
  border-color: #cbd5e1;
}
