<view class="page-container theme-{{theme}}">
  <scroll-view class="scrollarea" scroll-y="true" scroll-top="{{scrollTop}}" scroll-with-animation="true">
    <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
    <view class="header">
      <view class="title">
        顶层大秘境
        <text class="expand-all-btn" wx:if="{{activeTab === 'runs' && runsData.length > 0}}" bindtap="toggleAllRosters">{{allExpanded ? '全部收起' : '全部展开'}}</text>
      </view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>
    
    <view class="tabs-container">
      <view class="tab-item {{activeTab === 'runs' ? 'active' : ''}}" data-tab="runs" bindtap="switchTab">车队排行榜</view>
      <view class="tab-item {{activeTab === 'meta' ? 'active' : ''}}" data-tab="meta" bindtap="switchTab">阵容出场率</view>
    </view>

    <view class="filter-bar" wx:if="{{!loading && !errorMsg && activeTab === 'meta'}}">
      <text class="page-size-label">统计范围：</text>
      <picker mode="selector" range="{{metaSizeOptions}}" value="{{metaSizeIdx}}" bindchange="onMetaSizeChange">
        <view class="filter-btn">
          <text>{{metaSizeOptions[metaSizeIdx]}}</text>
          <text class="filter-icon">▼</text>
        </view>
      </picker>
    </view>
    
    <view class="status-message" wx:if="{{loading}}">
      <text>正在联系燃烧军团...</text>
    </view>
    
    <view class="status-message" wx:if="{{!loading && errorMsg}}" style="color: #F87171;">
      <text>{{errorMsg}}</text>
    </view>
    
    <block wx:if="{{!loading && !errorMsg && activeTab === 'meta' && metaData}}">
      <view class="meta-section">
        <view class="section-title">坦克出场率 (Tanks)</view>
        <view class="meta-list">
          <view class="meta-item" wx:for="{{metaData.tanks}}" wx:key="name">
            <text class="spec-name" style="color: {{item.color}}">{{item.name}}</text>
            <view class="bar-container">
              <view class="bar" style="width: {{(item.count / metaData.tanks[0].count) * 100}}%; background-color: {{item.color}}"></view>
            </view>
            <text class="count-num">{{item.count}}</text>
          </view>
        </view>
      </view>
      
      <view class="meta-section">
        <view class="section-title">治疗出场率 (Healers)</view>
        <view class="meta-list">
          <view class="meta-item" wx:for="{{metaData.healers}}" wx:key="name">
            <text class="spec-name" style="color: {{item.color}}">{{item.name}}</text>
            <view class="bar-container">
              <view class="bar" style="width: {{(item.count / metaData.healers[0].count) * 100}}%; background-color: {{item.color}}"></view>
            </view>
            <text class="count-num">{{item.count}}</text>
          </view>
        </view>
      </view>
      
      <view class="meta-section">
        <view class="section-title">近战输出出场率 (Melee DPS)</view>
        <view class="meta-list">
          <view class="meta-item" wx:for="{{metaData.melee}}" wx:key="name">
            <text class="spec-name" style="color: {{item.color}}">{{item.name}}</text>
            <view class="bar-container">
              <view class="bar" style="width: {{(item.count / metaData.melee[0].count) * 100}}%; background-color: {{item.color}}"></view>
            </view>
            <text class="count-num">{{item.count}}</text>
          </view>
        </view>
      </view>
      
      <view class="meta-section">
        <view class="section-title">远程输出出场率 (Ranged DPS)</view>
        <view class="meta-list">
          <view class="meta-item" wx:for="{{metaData.ranged}}" wx:key="name">
            <text class="spec-name" style="color: {{item.color}}">{{item.name}}</text>
            <view class="bar-container">
              <view class="bar" style="width: {{(item.count / metaData.ranged[0].count) * 100}}%; background-color: {{item.color}}"></view>
            </view>
            <text class="count-num">{{item.count}}</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{!loading && !errorMsg && activeTab === 'runs' && runsData}}">
      <view class="runs-list" wx:if="{{runsData.length > 0}}">
        <view class="run-card" wx:for="{{runsData}}" wx:key="rank" wx:for-index="index">
          <view class="run-header {{item.expanded ? 'expanded' : ''}}" bindtap="toggleRoster" data-index="{{index}}">
            <view class="run-rank">#{{item.rank}}</view>
            <view class="run-info">
              <text class="run-dungeon">{{item.level}}层 {{item.dungeon}}</text>
              <text class="run-score"> ({{item.score}}分)</text>
            </view>
            <view class="run-toggle-text">阵容</view>
          </view>
          <view class="run-roster" wx:if="{{item.expanded}}">
            <view class="roster-member" wx:for="{{item.roster}}" wx:for-item="member" wx:key="name">
              <view class="member-role">{{member.role === 'tank' ? '坦' : member.role === 'healer' ? '奶' : '输'}}</view>
              <view class="member-name">{{member.name}}</view>
              <view class="member-spec" style="color: {{member.color}}">{{member.spec}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="pagination" wx:if="{{!loading && !errorMsg && activeTab === 'runs'}}">
      <view class="btn prev-btn {{currentPage === 0 ? 'disabled' : ''}}" bindtap="prevPage">◀ 上一页</view>
      <view class="page-num">第 {{currentPage + 1}} 页</view>
      <view class="btn next-btn" bindtap="nextPage">下一页 ▶</view>
    </view>

    <view class="filter-bar" wx:if="{{!loading && !errorMsg && activeTab === 'runs'}}">
      <text class="page-size-label">每页加载条数：</text>
      <picker mode="selector" range="{{pageSizeOptions}}" value="{{pageSizeIdx}}" bindchange="onPageSizeChange">
        <view class="filter-btn">
          <text>{{pageSizeOptions[pageSizeIdx]}}</text>
          <text class="filter-icon">▼</text>
        </view>
      </picker>
    </view>



    <view class="footer" wx:if="{{!loading}}">
      <view>数据基于 Raider.io 实时抓取</view>
      <view>仅统计顶端车队阵容</view>
    </view>
  </scroll-view>
</view>
