<view class="page-container theme-{{theme}}">
  <scroll-view class="scrollarea" scroll-y="true" scroll-top="{{scrollTop}}" scroll-with-animation="true" refresher-enabled="{{true}}" bindrefresherrefresh="onPullDownRefresh" refresher-triggered="{{isRefreshing}}">
    <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
    <view class="header">
      <view class="title">大米前百数据</view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>
    
    <view class="top-toolbar" wx:if="{{!loading && !errorMsg && runsData && runsData.length > 0}}">
      <view class="run-count-tag">
        <text class="tag-dot"></text>
        <text>TOP 100 顶尖车队</text>
      </view>
      <view class="toolbar-actions">
        <text class="action-btn" bindtap="toggleAllRosters">{{allExpanded ? '全部收起' : '全部展开'}}</text>
        <text class="action-btn stat-action-btn" bindtap="showStatisticsModal">前百统计</text>
      </view>
    </view>
    
    <view class="error-container" wx:if="{{errorMsg}}">
      <view class="error-content">
        <text class="error-icon">⚠️</text>
        <text class="error-text">{{errorMsg}}</text>
      </view>
      <view class="retry-btn" bindtap="retryFetch">
        <text class="retry-btn-icon">↻</text>
        <text>点击重试</text>
      </view>
    </view>
    
    <block wx:if="{{!loading && !errorMsg && runsData}}">
      <view class="runs-list" wx:if="{{runsData.length > 0}}">
        <view class="run-card" wx:for="{{runsData}}" wx:key="rank" wx:for-index="index">
          <view class="run-header {{item.expanded ? 'expanded' : ''}}" bindtap="toggleRoster" data-index="{{index}}">
            <view class="run-rank">#{{item.rank}}</view>
            <view class="run-info">
              <text class="run-dungeon">{{item.level}}层 {{item.dungeon}}</text>
              <text class="run-score"> ({{item.score}}分)</text>
            </view>
            <view class="run-toggle-text">阵容</view>
          </view>
          <view class="run-roster" wx:if="{{item.expanded}}">
            <view class="roster-member" wx:for="{{item.roster}}" wx:for-item="member" wx:key="name">
              <view class="member-role">{{member.role === 'tank' ? '坦' : member.role === 'healer' ? '奶' : '输'}}</view>
              <view class="member-name">{{member.name}}</view>
              <view class="member-spec" style="color: {{member.color}}">{{member.spec}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="footer" wx:if="{{!loading && !errorMsg}}">
      <view>数据基于 Raider.io 实时抓取</view>
      <view>已展示全部前 100 名顶尖车队阵容</view>
    </view>
  </scroll-view>

  <!-- 悬浮统计按钮 -->
  <view class="floating-stat-btn" wx:if="{{!loading && !errorMsg && runsData && runsData.length > 0}}" bindtap="showStatisticsModal">
    <text class="stat-icon">📊</text>
    <text class="stat-text">前百统计</text>
  </view>

  <view class="modal-overlay" wx:if="{{showMetaModal}}" bindtap="closeStatisticsModal">
    <view class="modal-content" catchtap="return">
      <view class="modal-header">
        <text class="modal-title">前 100 名出场率统计</text>
        <text class="close-btn" bindtap="closeStatisticsModal">×</text>
      </view>
      <scroll-view scroll-y="true" class="modal-body" wx:if="{{metaData}}">
        <view class="meta-section">
          <view class="section-title">坦克出场率 (Tanks)</view>
          <view class="meta-list">
            <view class="meta-item" wx:for="{{metaData.tanks}}" wx:key="name">
              <text class="spec-name" style="color: {{item.color}}">{{item.name}}</text>
              <view class="bar-container">
                <view class="bar" style="width: {{(item.count / metaData.tanks[0].count) * 100}}%; background-color: {{item.color}}"></view>
              </view>
              <text class="count-num">{{item.count}}</text>
            </view>
          </view>
        </view>
        
        <view class="meta-section">
          <view class="section-title">治疗出场率 (Healers)</view>
          <view class="meta-list">
            <view class="meta-item" wx:for="{{metaData.healers}}" wx:key="name">
              <text class="spec-name" style="color: {{item.color}}">{{item.name}}</text>
              <view class="bar-container">
                <view class="bar" style="width: {{(item.count / metaData.healers[0].count) * 100}}%; background-color: {{item.color}}"></view>
              </view>
              <text class="count-num">{{item.count}}</text>
            </view>
          </view>
        </view>
        
        <view class="meta-section">
          <view class="section-title">近战输出 (Melee DPS)</view>
          <view class="meta-list">
            <view class="meta-item" wx:for="{{metaData.melee}}" wx:key="name">
              <text class="spec-name" style="color: {{item.color}}">{{item.name}}</text>
              <view class="bar-container">
                <view class="bar" style="width: {{(item.count / metaData.melee[0].count) * 100}}%; background-color: {{item.color}}"></view>
              </view>
              <text class="count-num">{{item.count}}</text>
            </view>
          </view>
        </view>
        
        <view class="meta-section">
          <view class="section-title">远程输出 (Ranged DPS)</view>
          <view class="meta-list">
            <view class="meta-item" wx:for="{{metaData.ranged}}" wx:key="name">
              <text class="spec-name" style="color: {{item.color}}">{{item.name}}</text>
              <view class="bar-container">
                <view class="bar" style="width: {{(item.count / metaData.ranged[0].count) * 100}}%; background-color: {{item.color}}"></view>
              </view>
              <text class="count-num">{{item.count}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="modal-share-btn" open-type="share">分享统计给好友</button>
      </view>
    </view>
  </view>

  <!-- Custom Loading Overlay -->
  <view class="custom-loading-overlay" wx:if="{{showCustomLoading}}" catchtouchmove="preventTouchMove">
    <view class="custom-loading-box">
      <view class="loading-text-container">
        <text class="loading-text">正在联系燃烧军团</text>
        <text class="loading-dots">{{loadingDots}}</text>
      </view>
    </view>
  </view>

</view>
