/* pages/meta/meta.wxss */
/* ================= 浅色主题变量 ================= */
.theme-light {
  --bg-color: #e8f1f8;
  --card-bg: #f3f7fc;
  --text-primary: #0f2742;
  --text-secondary: #4a6885;
  --border-color: #cde0f0;
  --bar-bg: #d7e7f5;
  --tab-bg: #e2eef9;
  --tab-active-bg: #f3f7fc;
}

/* ================= 深色主题变量 ================= */
.theme-dark {
  --bg-color: #111827;
  --card-bg: #1F2937;
  --text-primary: #FFFFFF;
  --text-secondary: #9CA3AF;
  --border-color: #374151;
  --bar-bg: #374151;
  --tab-bg: #1F2937;
  --tab-active-bg: #374151;
}

.page-container {
  height: 100vh;
  background-color: var(--bg-color);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
}

.scrollarea {
  flex: 1;
  height: 100%;
  padding: 10rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.nav-header {
  display: inline-flex;
  align-items: center;
  padding: 0 60rpx 0 10rpx;
  margin-left: 10rpx;
  
  color: var(--text-secondary);
  font-size: 32rpx;
  font-weight: 500;
  cursor: pointer;
}

.back-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  margin-bottom: 4rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
  position: relative;
}

.theme-toggle {
  position: absolute;
  left: 0rpx;
  top: 10rpx;
  font-size: 40rpx;
  padding: 10rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}

.expand-all-btn {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0;
}

.expand-all-btn:active {
  transform: scale(0.95);
}

.subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* Removed tabs container styles */

.status-message {
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
  margin: 100rpx 0;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 80rpx 40rpx;
  padding: 40rpx 30rpx;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.error-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.error-icon {
  font-size: 32rpx;
}

.error-text {
  font-size: 26rpx;
  color: #f87171;
  font-weight: 500;
}

.retry-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #3b82f6;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
  transition: all 0.2s;
}

.retry-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.retry-btn-icon {
  font-size: 26rpx;
}

/* Sections */
.meta-section {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 10rpx -3rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 12rpx;
}

.meta-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tier-badge {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 12rpx;
  text-shadow: 0 1px 2px rgba(0,0,0,0.8);
}

.spec-name {
  width: 200rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-shadow: 0 1px 2px rgba(0,0,0,0.8);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Complex layout for DPS/Tanks/Healers */
.meta-item-complex {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.complex-header {
  display: flex;
  align-items: center;
}

.stats-row {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.stat-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.bar-container-complex {
  width: 100%;
  height: 12rpx;
  background: var(--bar-bg);
  border-radius: 6rpx;
  position: relative;
  overflow: hidden;
}

.bar-container {
  flex: 1;
  height: 24rpx;
  background: var(--bar-bg);
  border-radius: 6rpx;
  margin: 0 16rpx;
  position: relative;
  overflow: hidden;
}

.bar {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: inset 0 2px 4px rgba(255,255,255,0.2), inset 0 -2px 4px rgba(0,0,0,0.2);
}

.count-num {
  width: 70rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: right;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin: 40rpx 0 140rpx 0;
}

/* Top Toolbar */
.top-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.run-count-tag {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #10b981;
  margin-right: 12rpx;
  box-shadow: 0 0 8rpx #10b981;
}

.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.06);
  cursor: pointer;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.96);
  opacity: 0.8;
}

.stat-action-btn {
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  color: #ffffff;
  border: none;
  box-shadow: 0 4rpx 10rpx rgba(59, 130, 246, 0.3);
}

/* Floating Action Button */
.floating-stat-btn {
  position: fixed;
  right: 36rpx;
  bottom: 60rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  color: #ffffff;
  padding: 18rpx 32rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.45);
  z-index: 90;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  animation: floatBounce 0.3s ease;
}

.floating-stat-btn:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.stat-icon {
  font-size: 32rpx;
}

@keyframes floatBounce {
  from { opacity: 0; transform: translateY(20rpx) scale(0.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* Run Cards */
/* Removed filter bar styles */

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  background: var(--card-bg);
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.runs-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 30rpx;
}

.run-card {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  box-shadow: 0 2rpx 6rpx -2rpx rgba(0, 0, 0, 0.05);
}

.run-header {
  display: flex;
  align-items: center;
  transition: all 0.2s;
}

.run-header.expanded {
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 10rpx;
  margin-bottom: 10rpx;
}

.run-rank {
  font-size: 32rpx;
  font-weight: 800;
  color: #fbbf24; /* Tailwind yellow-400 */
  width: 85rpx;
}

.run-info {
  flex: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.run-dungeon {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.run-score {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

.run-toggle-text {
  font-size: 22rpx;
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
  font-weight: 600;
}

.run-roster {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.roster-member {
  display: flex;
  align-items: center;
  background: var(--bg-color);
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}

.member-role {
  font-size: 24rpx;
  margin-right: 12rpx;
}

.member-name {
  flex: 1;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.member-spec {
  font-size: 22rpx;
  font-weight: 700;
  text-align: right;
}

/* Pagination */
.pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0 40rpx 0;
  padding: 0 20rpx;
}

.pagination .btn {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 6rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
}

.pagination .btn:active {
  transform: scale(0.95);
}

.pagination .btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.pagination .page-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.pagination .stat-btn {
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  color: #ffffff;
  border: none;
}

/* Modal Styles */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: fadeInModal 0.2s ease;
}

@keyframes fadeInModal {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: var(--bg-color);
  width: 90%;
  height: 80%;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.4);
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.close-btn {
  font-size: 50rpx;
  color: var(--text-secondary);
  line-height: 1;
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
  height: 0;
}

/* Custom Loading Overlay */
.custom-loading-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: fadeInModal 0.2s ease;
}
.custom-loading-box {
  background: var(--card-bg);
  padding: 50rpx 60rpx;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.loading-text-container {
  display: flex;
  align-items: baseline;
  justify-content: center;
  width: 380rpx;
}
.loading-text {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}
.loading-dots {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
  width: 60rpx;
  text-align: left;
}
