<view class="mdt-page">
  <!-- 自定义导航栏与顶部工具条 -->
  <view class="custom-nav" style="padding-top: {{menuButtonTop}}px;">
    <view class="nav-bar-content" style="height: {{menuButtonHeight}}px;">
      <view class="back-btn" bindtap="navigateBack">
        <text class="back-icon">‹</text>
        <text class="back-text">返回</text>
      </view>
      <view class="dungeon-selector" bindtap="switchDungeon">
        <text class="dungeon-title">{{currentDungeonName}}</text>
        <text class="dungeon-arrow">▾</text>
      </view>
    </view>
  </view>

  <!-- 次级工具栏 -->
  <view class="sub-header">
    <view class="sub-title">大秘境路线规划 (Alpha)</view>
    <view class="header-tools">
      <view class="tool-btn danger" bindtap="clearActivePull" wx:if="{{pulls[activePullIndex].enemyIds.length > 0}}">清空本波</view>
      <view class="tool-btn" bindtap="resetAll">全部重置</view>
      <view class="tool-btn highlight" bindtap="importMDT">导入代码</view>
    </view>
  </view>

  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-header">
      <text class="progress-label">敌军进度</text>
      <text class="progress-numbers">{{currentForces}} / {{totalForces}} ({{percent}}%)</text>
    </view>
    <view class="bar-bg">
      <view class="bar-fill {{percent >= 100 ? 'done' : ''}}" style="width: {{percent > 100 ? 100 : percent}}%;"></view>
    </view>
  </view>

  <!-- 地图主视窗 (双指缩放/自由拖拽) -->
  <view class="map-container">
    <movable-area class="map-area" scale-area>
      <movable-view 
        class="map-view" 
        direction="all" 
        scale="true" 
        scale-min="0.25" 
        scale-max="4" 
        x="0" 
        y="0"
        out-of-bounds="true"
        style="width: {{mapWidth}}px; height: {{mapHeight}}px;">
        
        <!-- 无缝拼接高清底图 -->
        <image class="map-bg" src="{{mapImage}}" style="width: 100%; height: 100%;" mode="scaleToFill" />
        
        <!-- 画布（绘制拉怪路径） -->
        <canvas type="2d" id="routeCanvas" class="route-canvas" style="width: {{mapWidth}}px; height: {{mapHeight}}px;"></canvas>
        
        <!-- 怪物标记点 -->
        <view class="enemy-layer">
          <view 
            wx:for="{{enemies}}" 
            wx:key="id" 
            class="enemy-node {{item.selected ? 'selected' : ''}} {{item.isBoss ? 'boss' : ''}}" 
            style="left: {{item.x * 100}}%; top: {{item.y * 100}}%; background-color: {{item.selected ? item.color : (item.isBoss ? '#c084fc' : '#94a3b8')}}; border-color: {{item.selected ? '#ffffff' : '#0f172a'}};" 
            bindtap="toggleEnemy" 
            data-id="{{item.id}}">
          </view>
        </view>
        
      </movable-view>
    </movable-area>

    <!-- 点击怪物的悬浮卡片提示 -->
    <view class="enemy-hud" wx:if="{{selectedEnemyInfo}}" catchtap="dismissEnemyTip">
      <view class="hud-left">
        <view class="hud-name">
          <text class="hud-boss-badge" wx:if="{{selectedEnemyInfo.isBoss}}">首领</text>
          <text>{{selectedEnemyInfo.name}}</text>
        </view>
        <view class="hud-desc">
          同组: {{selectedEnemyInfo.packCount}}只 | 贡献: +{{selectedEnemyInfo.forces}} ({{selectedEnemyInfo.percent}}%)
        </view>
      </view>
      <view class="hud-right">
        <text class="hud-status">{{selectedEnemyInfo.action}}</text>
        <text class="hud-close">✕</text>
      </view>
    </view>
  </view>

  <!-- 底部波次控制台 -->
  <view class="bottom-panel">
    <view class="panel-hint">当前编辑: Pull {{activePullIndex + 1}} (轻触切换，长按删除波次)</view>
    <scroll-view scroll-x="true" class="pulls-list">
      <view 
        wx:for="{{pulls}}" 
        wx:key="index"
        class="pull-item {{activePullIndex === index ? 'active' : ''}}" 
        style="border-top-color: {{item.color}};"
        bindtap="selectPull" 
        bindlongpress="deletePull"
        data-index="{{index}}">
        <text class="pull-num">Pull {{index + 1}}</text>
        <text class="pull-forces">+{{item.forces}}</text>
      </view>
      
      <!-- 新增波次按钮 -->
      <view class="pull-item add-pull" bindtap="addPull">
        <text class="add-icon">+</text>
        <text class="add-text">新波次</text>
      </view>
    </scroll-view>
  </view>
</view>
