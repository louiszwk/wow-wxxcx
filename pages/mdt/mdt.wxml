<view class="mdt-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{menuButtonTop}}px;">
    <view class="nav-bar-content" style="height: {{menuButtonHeight}}px;">
      <view class="back-btn" bindtap="navigateBack">
        <text class="back-icon">‹</text>
        <text class="back-text">返回</text>
      </view>
      <view class="dungeon-selector" bindtap="openDungeonModal">
        <text class="dungeon-title">{{currentDungeonName}}</text>
        <text class="mode-badge edit" wx:if="{{mode === 'edit'}}">修改中</text>
        <text class="mode-badge view" wx:elif="{{mode === 'view'}}">预览</text>
        <text class="dungeon-arrow" wx:if="{{mode === 'create'}}">▾</text>
      </view>
    </view>
  </view>

  <!-- 次级工具栏 -->
  <view class="sub-header">
    <!-- 模式分段切换器：规划路线 vs 预览技能 (仅在编辑/创建模式下可切换规划；查看模式下保持只读浏览) -->
    <view class="mode-switch-segmented" wx:if="{{mode !== 'view'}}">
      <view 
        class="mode-switch-item {{interactiveMode === 'plan' ? 'active' : ''}}" 
        bindtap="switchInteractiveMode" 
        data-mode="plan">
        <text class="switch-text">规划</text>
      </view>
      <view 
        class="mode-switch-item {{interactiveMode === 'preview' ? 'active' : ''}}" 
        bindtap="switchInteractiveMode" 
        data-mode="preview">
        <text class="switch-text">预览</text>
      </view>
    </view>
    <view class="view-mode-pill" wx:else>
      <text class="pill-dot"></text>
      <text class="pill-text">只读查看模式</text>
    </view>

    <view class="header-tools">
      <view class="tool-btn reset-tool-btn" bindtap="resetAll" wx:if="{{interactiveMode === 'plan' && mode !== 'view'}}">重置</view>
      
      <!-- 需求1：仅创建人有编辑按钮，点击可进入修改模式 -->
      <view class="tool-btn highlight" bindtap="enterEditMode" wx:if="{{mode === 'view' && isAuthor}}">
        <text>编辑</text>
      </view>

      <view class="tool-btn highlight" bindtap="openSaveModal" wx:elif="{{mode === 'edit'}}">
        <text>保存修改</text>
      </view>
      <view class="tool-btn highlight" bindtap="openSaveModal" wx:elif="{{mode === 'create'}}">
        <text>保存发布</text>
      </view>
      <view class="tool-btn" bindtap="openSaveModal" wx:elif="{{mode === 'view' && !isAuthor}}">
        <text>另存路线</text>
      </view>

      <button class="tool-btn share-header-btn" open-type="share" data-id="current" bindtap="setShareRoute">
        <text>分享</text>
      </button>
    </view>
  </view>

  <!-- 路线名称与预览提示横幅 -->
  <view class="preview-mode-banner" wx:if="{{mode === 'view'}}">
    <text class="preview-banner-badge">{{isAuthor ? '我的路线' : '路线浏览'}}</text>
    <text class="preview-banner-text">{{saveRouteName || currentDungeonName}}{{saveRouteRemark ? (' · ' + saveRouteRemark) : ''}}（轻触怪物查机制{{isAuthor ? '，点「编辑」可修改' : ''}}）</text>
  </view>
  <view class="preview-mode-banner" wx:elif="{{interactiveMode === 'preview'}}">
    <text class="preview-banner-badge">技能预览</text>
    <text class="preview-banner-text">轻触地图上任意怪物头像，查看其技能与机制</text>
  </view>

  <!-- 敌军部队进度条 -->
  <view class="progress-bar">
    <view class="progress-header">
      <view class="progress-left">
        <text class="progress-label">敌军部队目标</text>
        <text class="progress-done-badge" wx:if="{{percent >= 100}}">✓ 达成</text>
      </view>
      <text class="progress-numbers {{percent >= 100 ? 'done-text' : ''}}">{{currentForces}} / {{totalForces}} ({{percent}}%)</text>
    </view>
    <view class="bar-bg">
      <view class="bar-fill {{percent >= 100 ? 'done' : ''}}" style="width: {{percent > 100 ? 100 : percent}}%;"></view>
    </view>
  </view>

  <!-- 地图主视窗 -->
  <view class="map-container" bindwheel="onMouseWheel">
    <!-- 加载骨架屏 -->
    <view class="map-skeleton" wx:if="{{mapLoading}}">
      <view class="skeleton-pulse"></view>
      <text class="skeleton-text">正在极速加载地图数据...</text>
    </view>

    <movable-area class="map-area" scale-area bindwheel="onMouseWheel">
      <movable-view 
        class="map-view" 
        direction="all" 
        scale="true" 
        scale-min="{{scaleMin}}" 
        scale-max="4.0" 
        scale-value="{{scaleValue}}"
        x="{{mapX}}"
        y="{{mapY}}"
        animation="{{mapAnimation}}"
        bindchange="onMapMove"
        bindscale="onScaleChange"
        out-of-bounds="false"
        damping="40"
        friction="2"
        inertia="false"
        bindwheel="onMouseWheel"
        style="width: {{mapWidth}}px; height: {{mapHeight}}px;">
        
        <!-- 底图 -->
        <image class="map-bg" src="{{mapImage}}" style="width: 100%; height: 100%;" mode="scaleToFill" bindload="onMapImageLoad" />
        
        <!-- Canvas：全部包围圈、箭头虚线、怪物真实头像及波次徽章一屏高效渲染，0 DOM 开销 -->
        <canvas 
          type="2d" 
          id="routeCanvas" 
          class="route-canvas" 
          style="width: {{mapWidth}}px; height: {{mapHeight}}px;"
          bindtouchstart="onCanvasTouchStart"
          bindlongpress="onCanvasLongPress"
          catchtap="onCanvasTap"></canvas>
      </movable-view>
    </movable-area>

    <!-- 浮动缩放控制 -->
    <view class="zoom-controls">
      <view class="zoom-btn" bindtap="zoomIn" hover-class="zoom-btn-active">+</view>
      <view class="zoom-btn zoom-indicator">{{scalePercent}}%</view>
      <view class="zoom-btn" bindtap="zoomOut" hover-class="zoom-btn-active">−</view>
      <view class="zoom-btn reset-btn" bindtap="resetZoom" hover-class="zoom-btn-active">适应</view>
    </view>

  </view>

  <!-- 底部波次控制台 -->
  <view class="bottom-panel">
    <!-- 波次信息与快捷动作栏 -->
    <view class="panel-header-bar">
      <view class="panel-status-text">
        <text class="pull-index-highlight">第 {{activePullIndex + 1}} 波</text>
        <text class="pull-meta-text"> · {{pulls[activePullIndex].enemyIds.length}}只怪 · +{{pulls[activePullIndex].forces}} ({{pulls[activePullIndex].percent}}%)</text>
      </view>
      <view class="panel-actions" wx:if="{{mode !== 'view'}}">
        <view class="action-btn" bindtap="editActivePullNote">
          <text>备注</text>
        </view>
        <view class="action-btn warn" bindtap="clearActivePull" wx:if="{{pulls[activePullIndex].enemyIds.length > 0}}">
          <text>清空</text>
        </view>
        <view class="action-btn danger" bindtap="deletePull" data-index="{{activePullIndex}}" wx:if="{{pulls.length > 1}}">
          <text>删除</text>
        </view>
      </view>
      <view class="panel-mode-tag" wx:else>
        <text class="panel-mode-text">路线浏览中</text>
      </view>
    </view>

    <!-- 水平滚动波次卡片列表 -->
    <scroll-view 
      scroll-x="true" 
      class="pulls-list" 
      enhanced="true" 
      show-scrollbar="false"
      scroll-into-view="{{activePullScrollId}}">
      <view 
        wx:for="{{pulls}}" 
        wx:key="index"
        id="pull-item-{{index}}"
        class="pull-item {{activePullIndex === index ? 'active' : ''}}" 
        style="border-top-color: {{item.color}};"
        bindtap="selectPull" 
        bindlongpress="deletePull"
        data-index="{{index}}">
        <view class="pull-header">
          <text class="pull-num-badge" style="background-color: {{item.color}};">{{index + 1}}</text>
          <text class="pull-num">第 {{index + 1}} 波</text>
        </view>
        <text class="pull-forces">+{{item.forces}} ({{item.percent}}%)</text>
        <text class="pull-note-badge" wx:if="{{item.note}}">📌 {{item.note}}</text>
      </view>
      
      <!-- 新增波次按钮 (仅规划模式) -->
      <view class="pull-item add-pull" bindtap="addPull" wx:if="{{mode !== 'view'}}">
        <text class="add-icon">+</text>
        <text class="add-text">新波次</text>
      </view>
    </scroll-view>
  </view>

  <!-- 切换副本弹窗 -->
  <view class="dungeon-modal-mask" wx:if="{{showDungeonModal}}" bindtap="closeDungeonModal">
    <view class="dungeon-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title-wrap">
          <text class="modal-icon">🏰</text>
          <text class="modal-title">选择地下城副本 (12.1 赛季)</text>
        </view>
        <view class="modal-close" bindtap="closeDungeonModal">✕</view>
      </view>
      
      <scroll-view scroll-y="true" class="dungeon-modal-list">
        <view 
          wx:for="{{dungeonNames}}" 
          wx:key="*this"
          class="dungeon-card {{currentDungeonName === item ? 'active' : ''}}"
          bindtap="onSelectDungeon"
          data-name="{{item}}">
          <view class="card-left">
            <view class="card-status-dot {{currentDungeonName === item ? 'current' : ''}}"></view>
            <text class="card-name">{{item}}</text>
          </view>
          <view class="card-right">
            <text class="card-tag" wx:if="{{currentDungeonName === item}}">正在规划</text>
            <text class="card-arrow" wx:else>→</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 我的路线方案库弹窗 (多路线列表与管理) -->
  <view class="route-modal-mask" wx:if="{{showRouteManager}}" bindtap="closeRouteManager">
    <view class="route-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title-wrap">
          <text class="modal-icon">📋</text>
          <text class="modal-title">我的路线方案 ({{currentDungeonName}})</text>
        </view>
        <view class="modal-close" bindtap="closeRouteManager">✕</view>
      </view>

      <view class="route-modal-subbar">
        <text class="saved-total-text">共 {{savedRoutes.length}} 个方案</text>
        <view class="save-new-btn" bindtap="openSaveModal">
          <text>保存当前路线</text>
        </view>
      </view>

      <!-- 路线列表 -->
      <scroll-view scroll-y="true" class="route-modal-list">
        <!-- 空状态 -->
        <view class="route-empty" wx:if="{{savedRoutes.length === 0}}">
          <text class="empty-icon">🗺️</text>
          <text class="empty-title">暂无保存的路线方案</text>
          <text class="empty-desc">在地图上规划好波次后，点击"保存"即可保存多个自定义路线方案！</text>
        </view>

        <!-- 路线卡片 -->
        <view 
          wx:for="{{savedRoutes}}" 
          wx:key="id"
          class="saved-route-card">
          <view class="route-card-top">
            <view class="route-name-wrap">
              <text class="route-name">{{item.name}}</text>
              <text class="route-forces-tag {{item.percent >= 100 ? 'done' : ''}}">{{item.totalForces}}/{{item.totalRequired}} ({{item.percent}}%)</text>
            </view>
            <text class="route-date">{{item.timeStr || ''}}</text>
          </view>

          <view class="route-remark-box" wx:if="{{item.remark}}">
            <text class="remark-icon">📝</text>
            <text class="remark-content">{{item.remark}}</text>
          </view>

          <view class="route-card-meta">
            <text class="meta-pulls">共 {{item.pullCount || item.pulls.length}} 波怪物</text>
            <view class="route-card-actions">
              <view class="card-action-btn load" bindtap="loadSavedRoute" data-id="{{item.id}}">加载</view>
              <button 
                class="card-action-btn share" 
                open-type="share" 
                data-id="{{item.id}}" 
                bindtap="setShareRoute">分享</button>
              <view class="card-action-btn delete" bindtap="deleteSavedRoute" data-id="{{item.id}}">删除</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 保存路线方案弹窗 (自定义名称与备注) -->
  <view class="save-modal-mask" wx:if="{{showSaveModal}}" bindtap="closeSaveModal">
    <view class="save-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title-wrap">
          <text class="modal-icon">💾</text>
          <text class="modal-title">保存路线方案</text>
        </view>
        <view class="modal-close" bindtap="closeSaveModal">✕</view>
      </view>

      <view class="save-form">
        <view class="form-item">
          <text class="form-label">路线名称</text>
          <input 
            class="form-input" 
            placeholder="例如: 集合石2箱稳健打法" 
            placeholder-class="input-placeholder"
            value="{{saveRouteName}}" 
            bindinput="onSaveRouteNameInput" 
            maxlength="25" />
        </view>

        <view class="form-item">
          <text class="form-label">战术备注 (选填)</text>
          <textarea 
            class="form-textarea" 
            placeholder="例如: 第1波交嗜血爆发，第4波心能怪单控跳怪，尾王前补进度" 
            placeholder-class="input-placeholder"
            value="{{saveRouteRemark}}" 
            bindinput="onSaveRouteRemarkInput" 
            maxlength="120" />
        </view>

        <view class="form-item">
          <text class="form-label">作者署名</text>
          <input 
            class="form-input" 
            placeholder="例如: 头铁迪 或 匿名" 
            placeholder-class="input-placeholder"
            value="{{saveAuthorName}}" 
            bindinput="onSaveAuthorNameInput" 
            maxlength="15" />
        </view>

        <view class="form-item">
          <text class="form-label">适用难度层级</text>
          <view class="level-tabs-selector">
            <view 
              wx:for="{{levelRangeOptions}}" 
              wx:key="*this"
              class="level-tab-option {{saveRouteLevelRange === item ? 'active' : ''}}"
              bindtap="onSelectSaveLevelRange"
              data-level="{{item}}">
              {{item}}
            </view>
          </view>
        </view>

        <view class="route-preview-summary">
          <text>当前进度: {{currentForces}} / {{totalForces}} ({{percent}}%) · {{pulls.length}} 个波次</text>
        </view>

        <view class="save-form-actions">
          <view class="form-btn cancel" bindtap="closeSaveModal">取消</view>
          <view class="form-btn confirm" bindtap="confirmSaveRoute">
            {{mode === 'edit' ? '确认保存修改' : '确认发布路线'}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 怪物技能与机制图鉴弹窗 (预览模式点击怪物头像弹出) -->
  <view class="enemy-modal-mask" wx:if="{{showEnemyModal}}" bindtap="closeEnemyModal">
    <view class="enemy-modal {{inspectedEnemy.isBoss ? 'boss-modal' : ''}}" catchtap="stopPropagation">
      <!-- 弹窗顶栏 -->
      <view class="enemy-modal-header">
        <view class="enemy-header-left">
          <view class="enemy-avatar-wrap {{inspectedEnemy.isBoss ? 'boss-avatar-wrap' : ''}}">
            <image class="enemy-header-avatar" src="{{inspectedEnemy.portraitUrl}}" mode="aspectFill" />
            <text class="enemy-avatar-crown" wx:if="{{inspectedEnemy.isBoss}}">👑</text>
          </view>
          <view class="enemy-title-wrap">
            <view class="enemy-name-row">
              <text class="enemy-cn-name">{{inspectedEnemy.nameCn}}</text>
              <text class="enemy-boss-tag" wx:if="{{inspectedEnemy.isBoss}}">首领 Boss</text>
              <text class="enemy-type-tag" wx:else>{{inspectedEnemy.creatureTypeCn}}</text>
            </view>
            <text class="enemy-en-name">{{inspectedEnemy.name}} · ID: {{inspectedEnemy.npcId}}</text>
          </view>
        </view>
        <view class="modal-close-btn" bindtap="closeEnemyModal">✕</view>
      </view>

      <!-- 核心数值栏 -->
      <view class="enemy-stats-bar">
        <view class="stat-block">
          <text class="stat-label">基础血量</text>
          <text class="stat-val health">{{inspectedEnemy.healthStr}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-block">
          <text class="stat-label">敌军部队</text>
          <text class="stat-val forces">+{{inspectedEnemy.forces}} ({{inspectedEnemy.forcesPercent}}%)</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-block">
          <text class="stat-label">路线归属</text>
          <view class="stat-pull-val" wx:if="{{inspectedEnemy.assignedPull}}">
            <text class="stat-pull-dot" style="background-color: {{inspectedEnemy.assignedPull.color}};"></text>
            <text class="stat-val pull" style="color: {{inspectedEnemy.assignedPull.color}};">第 {{inspectedEnemy.assignedPull.pullNum}} 波</text>
          </view>
          <text class="stat-val unassigned" wx:else>未编入波次</text>
        </view>
      </view>

      <!-- 受控与免疫特性标签 (昏迷/打断/嘲讽/致盲等) -->
      <view class="enemy-chars-box" wx:if="{{inspectedEnemy.characteristics && inspectedEnemy.characteristics.length > 0}}">
        <text class="chars-box-title">受控特性</text>
        <view class="chars-tags-wrap">
          <view 
            wx:for="{{inspectedEnemy.characteristics}}" 
            wx:key="key" 
            class="char-chip">
            <text class="char-dot"></text>
            <text class="char-text">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 技能机制列表 -->
      <view class="spells-section-header">
        <text class="spells-title">⚔️ 怪物技能与重要机制</text>
        <text class="spells-badge">{{inspectedEnemy.spells.length}} 个技能</text>
      </view>

      <scroll-view scroll-y="true" class="enemy-spells-scroll">
        <!-- 无特化读条技能提示 -->
        <view class="no-spells-tip" wx:if="{{!inspectedEnemy.spells || inspectedEnemy.spells.length === 0}}">
          <text class="no-spells-icon">🛡️</text>
          <text class="no-spells-text">此怪物仅有基础普通近战攻击，无致命读条技能</text>
        </view>

        <!-- 技能卡片列表 -->
        <view 
          wx:for="{{inspectedEnemy.spells}}" 
          wx:key="id" 
          class="spell-card">
          <view class="spell-card-header">
            <image class="spell-icon" src="{{item.iconUrl}}" mode="aspectFill" />
            <view class="spell-header-info">
              <view class="spell-name-row">
                <text class="spell-name">{{item.name}}</text>
                <view class="spell-tags-wrap" wx:if="{{item.tags && item.tags.length > 0}}">
                  <text 
                    wx:for="{{item.tags}}" 
                    wx:for-item="tag" 
                    wx:key="*this" 
                    class="spell-tag {{tag === '全队AOE' ? 'aoe' : (tag === '坦克死刑' || tag === '高危' ? 'tank' : (tag === '可打断' ? 'interrupt' : (tag === '中毒' || tag === '流血' || tag === '诅咒' ? 'debuff' : 'alert')))}}">
                    {{tag}}
                  </text>
                </view>
              </view>
              <view class="spell-meta-row">
                <text class="spell-meta-chip" wx:if="{{item.castTime}}">⏱️ {{item.castTime}}</text>
                <text class="spell-meta-chip" wx:if="{{item.range}}">📏 {{item.range}}</text>
              </view>
            </view>
          </view>
          <view class="spell-desc-box">
            <text class="spell-desc-text">{{item.desc}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 弹窗底部操作按钮 -->
      <view class="enemy-modal-footer">
        <view 
          wx:if="{{mode !== 'view'}}"
          class="modal-btn toggle-pull-btn {{inspectedEnemy.assignedPull ? 'remove' : 'add'}}" 
          bindtap="toggleInspectedEnemyFromModal">
          <text wx:if="{{inspectedEnemy.assignedPull}}">从第 {{inspectedEnemy.assignedPull.pullNum}} 波移出</text>
          <text wx:else>标记加入第 {{activePullIndex + 1}} 波</text>
        </view>
        <view class="modal-btn close-btn {{mode === 'view' ? 'full-width' : ''}}" bindtap="closeEnemyModal">关闭</view>
      </view>
    </view>
  </view>
</view>
