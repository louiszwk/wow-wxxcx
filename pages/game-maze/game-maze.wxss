.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 14px 16px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 10px;
  font-size: 15px;
  cursor: pointer;
}

.back-icon {
  font-size: 22px;
  margin-right: 4px;
}

.header {
  margin-bottom: 10px;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 22px;
  font-weight: 800;
  background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #059669 0%, #0284c7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 11px;
  color: #94a3b8;
  margin-top: 2px;
}

.theme-light .subtitle {
  color: #64748b;
}

.theme-toggle {
  font-size: 20px;
  padding: 4px;
}

/* Dashboard */
.dashboard {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.dash-box {
  flex: 1;
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  padding: 6px 4px;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.theme-light .dash-box {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.dash-label {
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 2px;
}

.theme-light .dash-label {
  color: #64748b;
}

.dash-val {
  font-size: 15px;
  font-weight: 800;
}

.highlight {
  color: #10b981;
}

/* Maze Grid Area */
.maze-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 12px;
}

.maze-grid {
  background: #090d16;
  border: 2px solid rgba(16, 185, 129, 0.35);
  border-radius: 12px;
  padding: 4px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.theme-light .maze-grid {
  background: #dbeafe;
  border-color: #93c5fd;
  box-shadow: 0 8px 20px rgba(180, 205, 230, 0.4);
}

.maze-row {
  display: flex;
}

.maze-cell {
  width: 27px;
  height: 27px;
  margin: 1px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 3px;
}

.cell-wall {
  background: #1e293b;
  box-shadow: inset 1px 1px 2px rgba(255, 255, 255, 0.08);
}

.theme-light .cell-wall {
  background: #94a3b8;
  box-shadow: inset 1px 1px 2px rgba(255, 255, 255, 0.3);
}

.cell-path {
  background: rgba(30, 41, 59, 0.2);
}

.theme-light .cell-path {
  background: #f3f7fc;
}

.cell-treasure {
  background: rgba(245, 158, 11, 0.15);
}

.cell-exit {
  background: rgba(56, 189, 248, 0.25);
  animation: portalPulse 1s infinite alternate;
}

.player-icon {
  font-size: 19px;
  animation: bounce 0.15s ease;
}

.item-icon {
  font-size: 16px;
}

@keyframes portalPulse {
  0% { transform: scale(0.9); }
  100% { transform: scale(1.1); }
}

@keyframes bounce {
  0% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* D-Pad Controls */
.dpad-controls {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding-bottom: 4px;
}

.dpad-row {
  display: flex;
  justify-content: center;
  gap: 12px;
}

.middle-row {
  align-items: center;
}

.dpad-btn {
  width: 60px;
  height: 48px;
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  transition: all 0.1s ease;
}

.theme-light .dpad-btn {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
  color: #0f2742;
}

.dpad-btn:active {
  transform: scale(0.92);
  background: #10b981;
  color: #ffffff;
}

.dpad-arrow {
  font-size: 20px;
  font-weight: 800;
}

.dpad-center {
  width: 52px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #94a3b8;
}

.theme-light .dpad-center {
  color: #64748b;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-card {
  width: 80%;
  background: #1e293b;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 24px 20px;
  text-align: center;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
}

.theme-light .modal-card {
  background: #f3f7fc;
  border: 1px solid #bfdbfe;
  color: #0f2742;
}

.modal-icon {
  font-size: 46px;
  margin-bottom: 8px;
}

.modal-title {
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 8px;
}

.modal-desc {
  font-size: 14px;
  color: #94a3b8;
  margin-bottom: 20px;
  line-height: 1.5;
}

.theme-light .modal-desc {
  color: #475569;
}

.highlight-val {
  font-size: 18px;
  font-weight: 800;
  color: #10b981;
}

.modal-btn-row {
  display: flex;
  gap: 10px;
}

.modal-btn {
  flex: 1;
  font-size: 14px;
  font-weight: 700;
  border-radius: 20px;
  border: none;
  padding: 8px 0;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
  color: #ffffff;
}

.modal-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.theme-light .modal-btn.secondary {
  background: #e2e8f0;
  border-color: #cbd5e1;
}
