<view class="page-container theme-{{theme}}">
  <!-- Custom Nav Header -->
  <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
    <text class="back-icon">‹</text>
    <text class="back-text">返回游乐场</text>
  </view>

  <!-- Title & Theme Toggle -->
  <view class="header">
    <view class="title-row">
      <view class="title">🐾 哀嚎洞穴迷宫</view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>
    <view class="subtitle">德鲁伊寻路探秘 · 收集翡翠梦境宝藏 · 寻找达拉然传送门脱困</view>
  </view>

  <!-- Stats Dashboard -->
  <view class="dashboard">
    <view class="dash-box">
      <text class="dash-label">用时计时</text>
      <text class="dash-val highlight">{{timer}}s</text>
    </view>
    <view class="dash-box">
      <text class="dash-label">洞穴宝物</text>
      <text class="dash-val">{{treasuresCollected}} / {{totalTreasures}}</text>
    </view>
    <view class="dash-box">
      <text class="dash-label">行走步数</text>
      <text class="dash-val">{{steps}}</text>
    </view>
    <view class="dash-box">
      <text class="dash-label">最佳纪录</text>
      <text class="dash-val">{{bestTime < 999 ? bestTime + 's' : '--'}}</text>
    </view>
  </view>

  <!-- Maze Grid Area (11x11) -->
  <view class="maze-wrapper">
    <view class="maze-grid">
      <view 
        wx:for="{{maze}}" 
        wx:for-item="row" 
        wx:for-index="r" 
        wx:key="r" 
        class="maze-row"
      >
        <view 
          wx:for="{{row}}" 
          wx:for-item="cell" 
          wx:for-index="c" 
          wx:key="c" 
          class="maze-cell cell-{{cell.type}}"
        >
          <!-- Player Token -->
          <block wx:if="{{playerPos.r === r && playerPos.c === c}}">
            <text class="player-icon">{{playerAvatar}}</text>
          </block>
          <!-- Item Token -->
          <block wx:elif="{{cell.item}}">
            <text class="item-icon">{{cell.item}}</text>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- D-Pad Directional Controls -->
  <view class="dpad-controls">
    <view class="dpad-row">
      <view class="dpad-btn up-btn" bindtap="moveUp">
        <text class="dpad-arrow">▲</text>
      </view>
    </view>
    <view class="dpad-row middle-row">
      <view class="dpad-btn left-btn" bindtap="moveLeft">
        <text class="dpad-arrow">◀</text>
      </view>
      <view class="dpad-center" bindtap="startNewMaze">
        <text class="center-text">重置</text>
      </view>
      <view class="dpad-btn right-btn" bindtap="moveRight">
        <text class="dpad-arrow">▶</text>
      </view>
    </view>
    <view class="dpad-row">
      <view class="dpad-btn down-btn" bindtap="moveDown">
        <text class="dpad-arrow">▼</text>
      </view>
    </view>
  </view>

  <!-- Victory Modal -->
  <view class="modal-mask" wx:if="{{gameWon}}">
    <view class="modal-card">
      <view class="modal-icon">🌀</view>
      <view class="modal-title">穿越迷宫！成功脱困！</view>
      <view class="modal-desc">
        用时 <text class="highlight-val">{{timer}}</text> 秒，走过 {{steps}} 步，集齐 {{treasuresCollected}} 件洞穴稀有宝藏！
      </view>
      <view class="modal-btn-row">
        <button class="modal-btn primary" bindtap="startNewMaze">探索新迷宫</button>
        <button class="modal-btn secondary" open-type="share">分享通关</button>
      </view>
    </view>
  </view>
</view>
