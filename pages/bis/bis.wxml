<view class="page-container">
  <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <view class="header">
    <view class="title">天赋与手法</view>
    <view class="subtitle">40 个专精各一套 12.1.5 天赋与输出手法</view>
    <view class="desc">天赋码取自 12.1.5 专精指南原文，可在游戏内直接导入；中文手法依据该页优先级归纳整理。</view>
  </view>

  <view class="class-list">
    <block wx:for="{{classes}}" wx:key="id">
      <view class="class-card">
        <view class="class-header" bindtap="toggleExpand" data-id="{{item.id}}" style="border-left-color: {{item.color}}">
          <view class="class-info">
            <text class="class-icon">{{item.icon}}</text>
            <text class="class-name" style="color: {{item.color}}">{{item.name}}</text>
          </view>
          <view class="expand-icon {{expandedClassId === item.id ? 'expanded' : ''}}">▼</view>
        </view>
        
        <view class="spec-list" wx:if="{{expandedClassId === item.id}}">
          <block wx:for="{{item.specs}}" wx:key="id" wx:for-item="spec">
            <view class="spec-item" bindtap="openBisGuide" data-class="{{item.id}}" data-spec="{{spec.id}}">
              <text class="spec-name">{{spec.name}}</text>
              <text class="spec-arrow">➔</text>
            </view>
          </block>
        </view>
      </view>
    </block>
  </view>
</view>
