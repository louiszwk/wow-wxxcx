<view class="page-container theme-{{theme}}">
  <scroll-view class="scrollarea" scroll-y="true">
    
    <!-- 顶部导航 -->
    <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
      <text class="back-icon">‹</text>
      <text class="back-text">游乐场</text>
    </view>

    <!-- 标题与主题切换 -->
    <view class="header">
      <view class="title-wrap">
        <text class="title">🃏 技能连连看</text>
      </view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>

    <!-- 1. 准备界面 (Ready) -->
    <view class="ready-view" wx:if="{{gameState === 'ready'}}">
      <view class="intro-card">
        <view class="intro-icon">🃏</view>
        <view class="intro-title">魔兽核心技能记忆翻牌</view>
        <view class="intro-desc">
          嗜血、无敌、战复、斩杀、冰箱... 考验你的瞬时记忆与魔兽熟练度！
        </view>

        <view class="eval-rules">
          <view class="star-rule">
            <text class="star-icon">⭐⭐⭐</text>
            <text class="star-desc">22 秒内完成 & 14 步以内</text>
          </view>
          <view class="star-rule">
            <text class="star-icon">⭐⭐</text>
            <text class="star-desc">36 秒内完成 & 20 步以内</text>
          </view>
          <view class="star-rule">
            <text class="star-icon">⭐</text>
            <text class="star-desc">顺利找出全部 8 对技能</text>
          </view>
        </view>

        <button class="primary-btn start-btn" bindtap="startGame">
          <text class="btn-text">开始翻牌</text>
        </button>
      </view>
    </view>

    <!-- 2. 游戏对局界面 (Playing) -->
    <view class="playing-view" wx:if="{{gameState === 'playing'}}">
      
      <!-- 游戏顶栏状态 -->
      <view class="game-hud">
        <view class="hud-item">
          <text class="hud-lbl">用时</text>
          <text class="hud-val hud-time">{{elapsedSeconds}}s</text>
        </view>
        <view class="hud-item">
          <text class="hud-lbl">步数</text>
          <text class="hud-val">{{moves}}</text>
        </view>
        <view class="hud-item">
          <text class="hud-lbl">已配对</text>
          <text class="hud-val hud-pairs">{{matchedCount}} / {{totalPairs}}</text>
        </view>
      </view>

      <!-- 连击提示 -->
      <view class="combo-pill" wx:if="{{combo > 1}}">
        <text>🔥 连对 x{{combo}}！记忆力爆表！</text>
      </view>

      <!-- 4x4 翻牌矩阵 -->
      <view class="card-grid">
        <view 
          class="card-wrapper {{item.isFlipped ? 'flipped' : ''}} {{item.isMatched ? 'matched' : ''}}"
          wx:for="{{cards}}"
          wx:key="uid"
          data-index="{{index}}"
          bindtap="onCardTap">
          
          <view class="card-inner">
            <!-- 卡牌背面 (未翻开) -->
            <view class="card-face card-back">
              <view class="crest-icon">🛡️</view>
              <view class="crest-label">WOW</view>
            </view>
            
            <!-- 卡牌正面 (翻开) -->
            <view class="card-face card-front" style="border-color: {{item.isMatched ? '#22c55e' : item.color}};">
              <view class="skill-emoji">{{item.emoji}}</view>
              <view class="skill-name">{{item.name}}</view>
            </view>
          </view>

        </view>
      </view>

    </view>

    <!-- 3. 结算界面 (Game Over) -->
    <view class="gameover-view" wx:if="{{gameState === 'game_over'}}">
      <view class="result-card">
        <view class="result-badge-top" wx:if="{{resultSummary.isNewBest}}">🎉 创下个人最短用时！</view>

        <!-- 星级评价 -->
        <view class="stars-row">
          <text class="star-active">★</text>
          <text class="{{resultSummary.stars >= 2 ? 'star-active' : 'star-dim'}}">★</text>
          <text class="{{resultSummary.stars >= 3 ? 'star-active' : 'star-dim'}}">★</text>
        </view>

        <view class="rank-title">「{{resultSummary.title}}」</view>

        <view class="score-spotlight">
          <text class="spotlight-num">{{resultSummary.timeUsed}} s</text>
          <text class="spotlight-unit">通关总用时</text>
        </view>

        <view class="stats-grid">
          <view class="stat-card">
            <text class="sc-val">{{resultSummary.moves}} 步</text>
            <text class="sc-lbl">消耗步数</text>
          </view>
          <view class="stat-card">
            <text class="sc-val">8 对</text>
            <text class="sc-lbl">完美配对</text>
          </view>
        </view>

        <view class="result-actions">
          <button class="primary-btn retry-btn" bindtap="startGame">
            <text class="btn-text">再翻一把 ↻</text>
          </button>
          <button class="secondary-btn share-btn" open-type="share">
            <text class="btn-text">分享速度榜 🚀</text>
          </button>
        </view>

        <view class="back-link" bindtap="navigateBack">
          <text>返回游乐场大厅</text>
        </view>
      </view>
    </view>

  </scroll-view>
</view>
