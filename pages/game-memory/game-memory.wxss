/* ================= 主题变量 ================= */
.theme-light {
  --bg-color: #f3f4f6;
  --card-bg: #ffffff;
  --card-border: #e5e7eb;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --card-back-bg: #e5e7eb;
  --card-front-bg: #ffffff;
}

.theme-dark {
  --bg-color: #0b0f19;
  --card-bg: #151d30;
  --card-border: #222f4c;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --card-back-bg: #1e293b;
  --card-front-bg: #151d30;
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.scrollarea {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx 60rpx;
}

.nav-header {
  display: flex;
  align-items: center;
  color: var(--text-primary);
  font-size: 32rpx;
  cursor: pointer;
}

.back-icon {
  font-size: 48rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.back-text {
  font-size: 30rpx;
  font-weight: 500;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0 28rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.theme-toggle {
  font-size: 34rpx;
  padding: 12rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 30rpx;
}

/* ================= 1. 准备界面 ================= */
.ready-view {
  margin-top: 20rpx;
}

.intro-card {
  background-color: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.2);
  text-align: center;
}

.intro-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.intro-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 36rpx;
}

.eval-rules {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  text-align: left;
  margin-bottom: 44rpx;
}

.star-rule {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 20rpx;
}

.star-icon {
  font-size: 26rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.star-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.primary-btn {
  background: linear-gradient(135deg, #ec4899, #db2777);
  color: #ffffff;
  font-weight: 800;
  font-size: 32rpx;
  border-radius: 44rpx;
  padding: 24rpx 0;
  width: 100%;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(236, 72, 153, 0.35);
}

.primary-btn:active {
  transform: scale(0.98);
}

/* ================= 2. 游戏对战界面 ================= */
.game-hud {
  display: flex;
  justify-content: space-between;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 18rpx 32rpx;
  margin-bottom: 24rpx;
}

.hud-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.hud-val {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.hud-time {
  color: #38bdf8;
}

.hud-pairs {
  color: #22c55e;
}

.combo-pill {
  background: linear-gradient(90deg, rgba(236, 72, 153, 0.2), rgba(168, 85, 247, 0.2));
  border: 1rpx solid rgba(236, 72, 153, 0.3);
  border-radius: 14rpx;
  padding: 10rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #f472b6;
  margin-bottom: 24rpx;
}

/* 4x4 卡牌网格 */
.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.card-wrapper {
  aspect-ratio: 1 / 1.15;
  perspective: 1000px;
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  text-align: center;
  transition: transform 0.45s ease;
  transform-style: preserve-3d;
}

.card-wrapper.flipped .card-inner {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 8rpx;
}

/* 背面 */
.card-back {
  background: var(--card-back-bg);
  border: 2rpx solid var(--card-border);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.crest-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.crest-label {
  font-size: 18rpx;
  font-weight: 800;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

/* 正面 */
.card-front {
  background: var(--card-front-bg);
  border: 3rpx solid #3b82f6;
  transform: rotateY(180deg);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.2);
}

.card-wrapper.matched .card-front {
  border-color: #22c55e !important;
  background: rgba(34, 197, 94, 0.12) !important;
  box-shadow: 0 0 16rpx rgba(34, 197, 94, 0.4);
}

.skill-emoji {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}

.skill-name {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
  text-align: center;
  word-break: break-all;
}

/* ================= 3. 结算界面 ================= */
.gameover-view {
  margin-top: 20rpx;
}

.result-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.3);
}

.result-badge-top {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 800;
  color: #ec4899;
  background: rgba(236, 72, 153, 0.15);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.stars-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.star-active {
  color: #f59e0b;
}

.star-dim {
  color: #4b5563;
}

.rank-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 32rpx;
}

.score-spotlight {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.spotlight-num {
  display: block;
  font-size: 68rpx;
  font-weight: 900;
  color: #38bdf8;
}

.spotlight-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
}

.sc-val {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.sc-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--card-border);
  color: var(--text-primary);
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 22rpx 0;
  width: 100%;
}

.back-link {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 10rpx;
}
