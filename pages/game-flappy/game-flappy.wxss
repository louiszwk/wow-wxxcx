/* ================= 主题变量 ================= */
.theme-light {
  --bg-color: #f3f4f6;
  --card-bg: #ffffff;
  --card-border: #e5e7eb;
  --text-primary: #111827;
  --text-secondary: #6b7280;
}

.theme-dark {
  --bg-color: #0b0f19;
  --card-bg: #151d30;
  --card-border: #222f4c;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.nav-header {
  display: flex;
  align-items: center;
  color: var(--text-primary);
  font-size: 32rpx;
  cursor: pointer;
}

.back-icon {
  font-size: 48rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.back-text {
  font-size: 30rpx;
  font-weight: 500;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 0 20rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.theme-toggle {
  font-size: 34rpx;
  padding: 12rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 30rpx;
}

/* 舞台容器 */
.canvas-wrap {
  position: relative;
  width: 100%;
  height: 980rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.4);
  border: 2rpx solid var(--card-border);
  margin-bottom: 24rpx;
}

.flappy-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 浮层 */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
  z-index: 10;
}

.ready-overlay {
  background: rgba(11, 15, 25, 0.85);
  flex-direction: column;
  padding: 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.ready-badge {
  font-size: 20rpx;
  font-weight: 800;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.15);
  border: 1rpx solid rgba(56, 189, 248, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.ready-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  animation: birdHover 1.5s ease-in-out infinite alternate;
}

@keyframes birdHover {
  0% { transform: translateY(-10rpx); }
  100% { transform: translateY(10rpx); }
}

.ready-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.ready-desc {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.tap-hint {
  font-size: 28rpx;
  font-weight: 800;
  color: #f59e0b;
  animation: pulseHint 1s infinite alternate;
}

@keyframes pulseHint {
  0% { transform: scale(0.96); opacity: 0.8; }
  100% { transform: scale(1.04); opacity: 1; }
}

/* 结算弹窗 */
.over-overlay {
  background: rgba(11, 15, 25, 0.9);
}

.result-box {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  width: 82%;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.4);
}

.res-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 800;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.res-medal {
  font-size: 32rpx;
  font-weight: 800;
  color: #38bdf8;
  margin-bottom: 8rpx;
}

.res-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 28rpx;
}

.score-row {
  display: flex;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.score-item {
  flex: 1;
}

.si-val {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.si-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.res-btn {
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 36rpx;
  padding: 18rpx 0;
  width: 100%;
  margin-bottom: 16rpx;
}

.restart-btn {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: #ffffff;
}

.share-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--card-border);
  color: var(--text-primary);
  margin-bottom: 0;
}

.bottom-tips {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}
