.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 12px;
  font-size: 15px;
  cursor: pointer;
}

.back-icon {
  font-size: 22px;
  margin-right: 4px;
}

.header {
  margin-bottom: 12px;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 22px;
  font-weight: 800;
  background: linear-gradient(135deg, #c084fc 0%, #ec4899 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #9333ea 0%, #db2777 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 2px;
}

.theme-light .subtitle {
  color: #64748b;
}

.theme-toggle {
  font-size: 20px;
  padding: 4px;
}

/* Dashboard */
.dashboard {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.stat-card {
  flex: 1;
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 8px 4px;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.theme-light .stat-card {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.stat-label {
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 2px;
}

.theme-light .stat-label {
  color: #64748b;
}

.stat-val {
  font-size: 16px;
  font-weight: 800;
}

.highlight {
  color: #ec4899;
}

.warning-text {
  color: #ef4444;
}

/* Combo Banner */
.combo-banner {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.3) 0%, rgba(168, 85, 247, 0.3) 100%);
  border: 1px solid #ec4899;
  border-radius: 10px;
  padding: 6px;
  text-align: center;
  margin-bottom: 10px;
  animation: pulse 1s infinite alternate;
}

.theme-light .combo-banner {
  background: linear-gradient(135deg, #fce7f3 0%, #f3e8ff 100%);
  border-color: #f472b6;
}

.combo-text {
  font-size: 13px;
  font-weight: 700;
  color: #f472b6;
}

.theme-light .combo-text {
  color: #db2777;
}

/* Board */
.board-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16px;
}

.board-grid {
  background: rgba(15, 23, 42, 0.85);
  border: 2px solid rgba(168, 85, 247, 0.4);
  border-radius: 16px;
  padding: 6px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.theme-light .board-grid {
  background: #dbeafe;
  border-color: #93c5fd;
  box-shadow: 0 8px 20px rgba(180, 205, 230, 0.4);
}

.board-row {
  display: flex;
}

.gem-cell {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 2px;
  border-radius: 10px;
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.05);
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.theme-light .gem-cell {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.gem-icon {
  font-size: 24px;
  user-select: none;
}

.gem-cell.selected {
  border: 2px solid #ec4899;
  background: rgba(236, 72, 153, 0.25);
  transform: scale(1.1);
  box-shadow: 0 0 12px rgba(236, 72, 153, 0.8);
  z-index: 2;
}

.theme-light .gem-cell.selected {
  background: #fdf2f8;
  border-color: #ec4899;
}

/* Controls */
.controls {
  padding: 0 20px;
  margin-top: auto;
  margin-bottom: 10px;
}

.action-btn {
  background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);
  color: #ffffff;
  font-size: 15px;
  font-weight: 700;
  border-radius: 24px;
  border: none;
  padding: 10px 0;
  box-shadow: 0 4px 14px rgba(168, 85, 247, 0.35);
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-card {
  width: 82%;
  background: #1e293b;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 24px 20px;
  text-align: center;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
}

.theme-light .modal-card {
  background: #f3f7fc;
  border: 1px solid #bfdbfe;
  color: #0f2742;
}

.modal-icon {
  font-size: 48px;
  margin-bottom: 8px;
}

.modal-title {
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 8px;
}

.modal-desc {
  font-size: 15px;
  color: #94a3b8;
  margin-bottom: 8px;
}

.theme-light .modal-desc {
  color: #475569;
}

.modal-score {
  font-size: 20px;
  font-weight: 800;
  color: #ec4899;
}

.modal-rank {
  font-size: 13px;
  color: #f59e0b;
  margin-bottom: 20px;
  line-height: 1.4;
}

.modal-btn-row {
  display: flex;
  gap: 10px;
}

.modal-btn {
  flex: 1;
  font-size: 14px;
  font-weight: 700;
  border-radius: 20px;
  border: none;
  padding: 8px 0;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);
  color: #ffffff;
}

.modal-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.theme-light .modal-btn.secondary {
  background: #e2e8f0;
  border-color: #cbd5e1;
}

@keyframes pulse {
  0% { transform: scale(0.98); }
  100% { transform: scale(1.02); }
}
