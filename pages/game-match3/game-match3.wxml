<view class="page-container theme-{{theme}}">
  <!-- Custom Nav Header -->
  <view class="nav-header" bindtap="navigateBack" style="margin-top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px;">
    <text class="back-icon">‹</text>
    <text class="back-text">返回游乐场</text>
  </view>

  <!-- Title & Theme Toggle -->
  <view class="header">
    <view class="title-row">
      <view class="title">🔮 达拉然魔法宝石</view>
      <view class="theme-toggle" bindtap="toggleTheme">{{theme === 'light' ? '🌙' : '☀️'}}</view>
    </view>
    <view class="subtitle">交换符文 · 3连消除 · 达成目标 1200 分</view>
  </view>

  <!-- Stats Dashboard -->
  <view class="dashboard">
    <view class="stat-card">
      <text class="stat-label">当前得分</text>
      <text class="stat-val highlight">{{score}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">目标得分</text>
      <text class="stat-val">{{targetScore}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">剩余步数</text>
      <text class="stat-val {{movesLeft <= 5 ? 'warning-text' : ''}}">{{movesLeft}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">历史最佳</text>
      <text class="stat-val">{{bestScore}}</text>
    </view>
  </view>

  <!-- Combo Alert Banner -->
  <view class="combo-banner" wx:if="{{combo > 1}}">
    <text class="combo-text">⚡ {{combo}} 连击连锁消除！额外加分！</text>
  </view>

  <!-- Gem Board -->
  <view class="board-container">
    <view class="board-grid">
      <view 
        wx:for="{{board}}" 
        wx:for-item="row" 
        wx:for-index="r" 
        wx:key="r" 
        class="board-row"
      >
        <view 
          wx:for="{{row}}" 
          wx:for-item="gem" 
          wx:for-index="c" 
          wx:key="c" 
          class="gem-cell {{selected && selected.r === r && selected.c === c ? 'selected' : ''}}"
          data-r="{{r}}"
          data-c="{{c}}"
          bindtap="onGemTap"
        >
          <text class="gem-icon">{{gem ? gem.icon : ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Restart Control -->
  <view class="controls">
    <button class="action-btn" bindtap="startNewGame">重新洗牌开局</button>
  </view>

  <!-- Game Over Modal -->
  <view class="modal-mask" wx:if="{{gameOver}}">
    <view class="modal-card">
      <view class="modal-icon">{{gameWon ? '🏆' : '⏳'}}</view>
      <view class="modal-title">{{gameWon ? '挑战大成功！' : '步数已耗尽'}}</view>
      <view class="modal-desc">最终斩获得分：<text class="modal-score">{{score}}</text> 分</view>
      <view class="modal-rank">
        {{gameWon ? '🎉 恭喜你成为达拉然三消特级符文大师！' : '再接再厉，还差一点就能打破目标！'}}
      </view>
      <view class="modal-btn-row">
        <button class="modal-btn primary" bindtap="startNewGame">再来一局</button>
        <button class="modal-btn secondary" open-type="share">分享战报</button>
      </view>
    </view>
  </view>
</view>
