.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16px;
  background-color: #0f172a;
  color: #f8fafc;
  transition: all 0.3s ease;
}

.theme-light {
  background-color: #e8f1f8;
  color: #0f2742;
}

.nav-header {
  display: flex;
  align-items: center;
  padding: 0 0 16px;
  font-size: 16px;
  cursor: pointer;
}

.back-icon {
  font-size: 24px;
  margin-right: 5px;
  margin-top: -2px;
}

.header {
  position: relative;
  margin-bottom: 14px;
}

.title {
  font-size: 24px;
  font-weight: 800;
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.theme-light .title {
  background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 4px;
}

.theme-light .subtitle {
  color: #475569;
}

.theme-toggle {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 22px;
  padding: 6px;
}

/* Class Picker */
.class-picker-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 12px;
  padding-bottom: 4px;
}

.class-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 600;
  color: #94a3b8;
  margin-right: 8px;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.theme-light .class-pill {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
  color: #475569;
}

.class-pill.active {
  background: #f59e0b;
  color: #0f172a;
  border-color: #fbbf24;
  font-weight: 700;
  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
}

.theme-light .class-pill.active {
  background: #d97706;
  color: #ffffff;
}

/* Points Bar */
.points-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  padding: 10px 14px;
  margin-bottom: 12px;
}

.theme-light .points-bar {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.points-stat {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 22px;
  font-weight: 800;
  color: #38bdf8;
}

.theme-light .stat-num {
  color: #0284c7;
}

.stat-label {
  font-size: 11px;
  color: #94a3b8;
}

.theme-light .stat-label {
  color: #64748b;
}

.level-badge {
  font-size: 11px;
  font-weight: 700;
  background: rgba(251, 191, 36, 0.15);
  color: #fbbf24;
  border: 1px solid rgba(251, 191, 36, 0.3);
  padding: 4px 8px;
  border-radius: 6px;
}

.reset-actions {
  display: flex;
  gap: 6px;
}

.mini-btn {
  font-size: 11px;
  padding: 4px 8px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #cbd5e1;
}

.theme-light .mini-btn {
  background: #e2e8f0;
  border: 1px solid #cbd5e1;
  color: #334155;
}

.mini-btn.copy-btn {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  border-color: rgba(56, 189, 248, 0.3);
}

/* Presets Section */
.presets-section {
  margin-bottom: 12px;
}

.preset-label {
  font-size: 12px;
  font-weight: 700;
  color: #fbbf24;
  margin-bottom: 6px;
}

.theme-light .preset-label {
  color: #b45309;
}

.preset-scroll {
  display: flex;
  white-space: nowrap;
  padding-bottom: 4px;
}

.preset-chip {
  display: inline-flex;
  flex-direction: column;
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: 10px;
  padding: 6px 12px;
  margin-right: 8px;
  min-width: 140px;
}

.theme-light .preset-chip {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
}

.preset-name {
  font-size: 12px;
  font-weight: 700;
  color: #f59e0b;
}

.theme-light .preset-name {
  color: #d97706;
}

.preset-desc {
  font-size: 10px;
  color: #94a3b8;
  margin-top: 2px;
}

.theme-light .preset-desc {
  color: #64748b;
}

/* 3-Tree Tabs */
.tree-tabs-bar {
  display: flex;
  background: rgba(30, 41, 59, 0.7);
  border-radius: 12px;
  padding: 4px;
  margin-bottom: 14px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.theme-light .tree-tabs-bar {
  background: #dbeafe;
  border: 1px solid #bfdbfe;
}

.tree-tab-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 8px 0;
  font-size: 13px;
  font-weight: 600;
  color: #94a3b8;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.theme-light .tree-tab-btn {
  color: #475569;
}

.tree-tab-btn.active {
  background: #f59e0b;
  color: #0f172a;
}

.theme-light .tree-tab-btn.active {
  background: #d97706;
  color: #ffffff;
}

.tree-pts {
  font-size: 11px;
}

/* Authentic 7x4 Talent Grid */
.talent-tree-grid {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 12px 8px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.theme-light .talent-tree-grid {
  background: #f3f7fc;
  border: 1px solid #cde0f0;
  box-shadow: 0 4px 20px rgba(180, 205, 230, 0.3);
}

.grid-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.tier-indicator {
  width: 32px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px dashed rgba(255, 255, 255, 0.1);
}

.theme-light .tier-indicator {
  background: #e2e8f0;
  border: 1px dashed #cbd5e1;
}

.tier-indicator.unlocked {
  border-color: rgba(56, 189, 248, 0.4);
}

.tier-pts {
  font-size: 10px;
  color: #64748b;
  transform: rotate(-90deg);
  white-space: nowrap;
}

.tier-indicator.unlocked .tier-pts {
  color: #38bdf8;
  font-weight: 700;
}

.grid-cols {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.grid-cell {
  position: relative;
  aspect-ratio: 1;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.grid-cell.empty {
  border: 1px dashed rgba(255, 255, 255, 0.05);
  pointer-events: none;
}

.theme-light .grid-cell.empty {
  border: 1px dashed rgba(0, 0, 0, 0.08);
}

/* States */
.grid-cell.locked {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.06);
  filter: grayscale(100%);
  opacity: 0.45;
}

.grid-cell.available {
  background: rgba(30, 41, 59, 0.7);
  border: 1.5px solid #64748b;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

.theme-light .grid-cell.available {
  background: #f3f7fc;
  border: 1.5px solid #94a3b8;
}

.grid-cell.allocated {
  background: rgba(16, 185, 129, 0.15);
  border: 1.5px solid #10b981;
  box-shadow: 0 0 8px rgba(16, 185, 129, 0.3);
}

.grid-cell.maxed {
  background: rgba(245, 158, 11, 0.2);
  border: 2px solid #fbbf24;
  box-shadow: 0 0 12px rgba(251, 191, 36, 0.5);
}

.node-icon-box {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.node-icon {
  font-size: 24px;
}

.lock-overlay {
  position: absolute;
  top: 2px;
  right: 2px;
  font-size: 10px;
}

.rank-badge {
  position: absolute;
  bottom: -4px;
  right: -4px;
  background: #0f172a;
  border: 1px solid #64748b;
  color: #94a3b8;
  font-size: 10px;
  font-weight: 700;
  padding: 1px 4px;
  border-radius: 4px;
}

.theme-light .rank-badge {
  background: #f3f7fc;
  border: 1px solid #cbd5e1;
  color: #334155;
}

.rank-badge.rank-max {
  background: #f59e0b;
  color: #0f172a;
  border-color: #fbbf24;
}

/* Tooltip / Modal Card */
.tooltip-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.tooltip-card {
  width: 100%;
  max-width: 360px;
  background: #111827;
  border: 1.5px solid #d97706;
  border-radius: 16px;
  padding: 18px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 15px rgba(217, 119, 6, 0.3);
}

.theme-light .tooltip-card {
  background: #f3f7fc;
  border: 1.5px solid #f59e0b;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
}

.tooltip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.tooltip-title-box {
  display: flex;
  align-items: center;
  gap: 10px;
}

.tooltip-icon {
  font-size: 28px;
}

.tooltip-title {
  font-size: 17px;
  font-weight: 800;
  color: #ffd100;
}

.theme-light .tooltip-title {
  color: #b45309;
}

.tooltip-rank {
  font-size: 12px;
  color: #94a3b8;
}

.tooltip-close {
  font-size: 18px;
  color: #94a3b8;
  padding: 4px;
}

.tooltip-warning {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid rgba(239, 68, 68, 0.3);
  color: #f87171;
  font-size: 12px;
  padding: 6px 10px;
  border-radius: 8px;
  margin-bottom: 10px;
}

.tooltip-body {
  background: rgba(0, 0, 0, 0.4);
  border-radius: 8px;
  padding: 10px;
  margin-bottom: 10px;
}

.theme-light .tooltip-body {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
}

.rank-desc-label {
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 4px;
}

.rank-desc-text {
  font-size: 13px;
  line-height: 1.5;
  color: #f8fafc;
}

.theme-light .rank-desc-text {
  color: #0f2742;
}

.green-text {
  color: #34d399;
}

.tooltip-actions {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.tooltip-btn {
  flex: 1;
  font-size: 13px;
  font-weight: 700;
  border-radius: 10px;
  padding: 10px 0;
  border: none;
}

.minus-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #f8fafc;
}

.theme-light .minus-btn {
  background: #e2e8f0;
  color: #0f2742;
}

.plus-btn {
  background: #f59e0b;
  color: #0f172a;
}

.tooltip-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}
