/* ================= 主题变量 ================= */
.theme-light {
  --bg-color: #f3f4f6;
  --card-bg: #ffffff;
  --card-border: #e5e7eb;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --option-bg: #f9fafb;
}

.theme-dark {
  --bg-color: #0b0f19;
  --card-bg: #151d30;
  --card-border: #222f4c;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --option-bg: #1a233a;
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.scrollarea {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx 60rpx;
}

.nav-header {
  display: flex;
  align-items: center;
  color: var(--text-primary);
  font-size: 32rpx;
  cursor: pointer;
}

.back-icon {
  font-size: 48rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.back-text {
  font-size: 30rpx;
  font-weight: 500;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0 28rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.theme-toggle {
  font-size: 34rpx;
  padding: 12rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 30rpx;
}

/* ================= 1. 准备界面 ================= */
.ready-view {
  margin-top: 20rpx;
}

.intro-card {
  background-color: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.2);
  text-align: center;
}

.intro-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.intro-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 36rpx;
}

.quiz-highlights {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  text-align: left;
  margin-bottom: 44rpx;
}

.highlight-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 20rpx;
}

.hl-badge {
  font-size: 20rpx;
  font-weight: 800;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.15);
  border: 1rpx solid rgba(56, 189, 248, 0.3);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.hl-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.45;
}

.primary-btn {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  font-weight: 800;
  font-size: 32rpx;
  border-radius: 44rpx;
  padding: 24rpx 0;
  width: 100%;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(59, 130, 246, 0.35);
}

.primary-btn:active {
  transform: scale(0.98);
}

/* ================= 2. 答题界面 ================= */
.quiz-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.quiz-progress {
  display: flex;
  align-items: baseline;
}

.current-q {
  font-size: 38rpx;
  font-weight: 800;
  color: #38bdf8;
}

.total-q {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

.quiz-timer {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
}

.timer-urgent {
  border-color: #ef4444;
  animation: timerBlink 0.8s infinite alternate;
}

@keyframes timerBlink {
  0% { box-shadow: 0 0 10rpx rgba(239, 68, 68, 0.3); }
  100% { box-shadow: 0 0 20rpx rgba(239, 68, 68, 0.8); }
}

.timer-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.timer-sec {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.timer-urgent .timer-sec {
  color: #f87171;
}

.quiz-score-box {
  display: flex;
  align-items: baseline;
}

.q-score {
  font-size: 36rpx;
  font-weight: 800;
  color: #f59e0b;
}

.q-score-lbl {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

.timer-track {
  width: 100%;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.timer-fill {
  height: 100%;
  background: linear-gradient(90deg, #38bdf8, #3b82f6);
  transition: width 1s linear;
}

.fill-urgent {
  background: linear-gradient(90deg, #f97316, #ef4444);
}

.combo-pill {
  background: linear-gradient(90deg, rgba(245, 158, 11, 0.2), rgba(239, 68, 68, 0.2));
  border: 1rpx solid rgba(245, 158, 11, 0.3);
  border-radius: 14rpx;
  padding: 10rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #fbbf24;
  margin-bottom: 24rpx;
}

/* 题目卡片 */
.question-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.question-category {
  margin-bottom: 16rpx;
}

.cat-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #a855f7;
  background: rgba(168, 85, 247, 0.15);
  border: 1rpx solid rgba(168, 85, 247, 0.3);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.question-text {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 34rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.option-item {
  display: flex;
  align-items: center;
  background: var(--option-bg);
  border: 2rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  transition: all 0.2s ease;
}

.option-item:active {
  transform: scale(0.99);
}

.option-prefix {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-secondary);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-content {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.option-status-icon {
  font-size: 32rpx;
  font-weight: 900;
  margin-left: 14rpx;
}

/* 作答后状态 */
.option-correct {
  border-color: #22c55e !important;
  background: rgba(34, 197, 94, 0.15) !important;
  color: #22c55e !important;
}

.option-correct .option-prefix {
  background: #22c55e;
  color: #ffffff;
}

.option-wrong {
  border-color: #ef4444 !important;
  background: rgba(239, 68, 68, 0.15) !important;
  color: #f87171 !important;
}

.option-wrong .option-prefix {
  background: #ef4444;
  color: #ffffff;
}

.option-faded {
  opacity: 0.45;
}

/* 解析框 */
.explanation-box {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.exp-title {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.exp-content {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.next-btn {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 36rpx;
  padding: 14rpx 0;
  width: 100%;
}

/* ================= 3. 结算界面 ================= */
.gameover-view {
  margin-top: 20rpx;
}

.result-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.3);
}

.result-badge-top {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 800;
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.15);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.rank-crown {
  font-size: 96rpx;
  margin-bottom: 12rpx;
}

.rank-tier {
  font-size: 64rpx;
  font-weight: 900;
  color: #a855f7;
  line-height: 1;
}

.rank-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin: 12rpx 0 32rpx;
}

.score-spotlight {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.spotlight-num {
  display: block;
  font-size: 68rpx;
  font-weight: 900;
  color: #f59e0b;
}

.spotlight-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
}

.sc-val {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.sc-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 错题复盘本 */
.review-box {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid var(--card-border);
  border-radius: 22rpx;
  padding: 26rpx 20rpx;
  margin-bottom: 36rpx;
  text-align: left;
}

.review-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #f87171;
  margin-bottom: 20rpx;
}

.review-item {
  border-bottom: 1rpx solid var(--card-border);
  padding: 18rpx 0;
}

.review-item:last-child {
  border-bottom: none;
}

.review-q {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.review-ans-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.your-ans {
  color: #f87171;
}

.right-ans {
  color: #22c55e;
  font-weight: 700;
}

.review-exp {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.45;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--card-border);
  color: var(--text-primary);
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 22rpx 0;
  width: 100%;
}

.back-link {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 10rpx;
}
