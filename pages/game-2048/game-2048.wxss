/* ================= 主题变量 ================= */
.theme-light {
  --bg-color: #f3f4f6;
  --card-bg: #ffffff;
  --card-border: #e5e7eb;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --board-bg: #cbd5e1;
  --cell-empty-bg: #e2e8f0;
}

.theme-dark {
  --bg-color: #0b0f19;
  --card-bg: #151d30;
  --card-border: #222f4c;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --board-bg: #1e293b;
  --cell-empty-bg: #0f172a;
}

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.scrollarea {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx 60rpx;
}

.nav-header {
  display: flex;
  align-items: center;
  color: var(--text-primary);
  font-size: 32rpx;
  cursor: pointer;
}

.back-icon {
  font-size: 48rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.back-text {
  font-size: 30rpx;
  font-weight: 500;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.theme-toggle {
  font-size: 34rpx;
  padding: 12rpx 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 30rpx;
}

/* 顶栏面板 */
.dashboard-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.game-intro-tag {
  display: flex;
  flex-direction: column;
}

.tag-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #38bdf8;
}

.tag-sub {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.scores-wrap {
  display: flex;
  gap: 16rpx;
}

.score-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  text-align: center;
  min-width: 120rpx;
}

.best-card {
  border-color: rgba(234, 179, 8, 0.4);
}

.sc-label {
  display: block;
  font-size: 18rpx;
  color: var(--text-secondary);
}

.sc-val {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.best-card .sc-val {
  color: #f59e0b;
}

/* 工具栏 */
.tools-row {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tool-btn {
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  background: var(--card-bg);
  color: var(--text-primary);
  border: 1rpx solid var(--card-border);
  margin: 0;
}

.undo-btn.disabled {
  opacity: 0.35;
}

/* 4x4 核心棋盘 */
.board-container {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  background: var(--board-bg);
  border-radius: 28rpx;
  padding: 18rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.25);
  margin-bottom: 28rpx;
}

.board-grid {
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.board-cell {
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.1s ease;
}

.cell-empty {
  background: var(--cell-empty-bg) !important;
  border: 1rpx solid transparent !important;
}

.cell-filled {
  border: 2rpx solid;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  animation: cellPop 0.15s ease-out;
}

@keyframes cellPop {
  0% { transform: scale(0.85); }
  100% { transform: scale(1); }
}

.cell-num {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.cell-name {
  font-size: 18rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

/* 浮层 */
.board-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(11, 15, 25, 0.88);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
  z-index: 10;
}

.overlay-content {
  text-align: center;
  padding: 30rpx;
}

.overlay-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.overlay-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.overlay-score {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 30rpx;
}

.overlay-btn {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 36rpx;
  padding: 16rpx 48rpx;
}

/* 方向按键 */
.dpad-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.dpad-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.middle-row {
  align-items: center;
  margin: 10rpx 0;
}

.dpad-key {
  width: 90rpx;
  height: 70rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 800;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.dpad-key:active {
  transform: scale(0.9);
  background: rgba(56, 189, 248, 0.2);
}

.dpad-center {
  font-size: 20rpx;
  color: var(--text-secondary);
  padding: 0 16rpx;
}

/* 图例 */
.legend-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
}

.legend-title {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.legend-badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.lg-arrow {
  color: var(--text-secondary);
  font-size: 16rpx;
}
